--- /tmp/claude-0/-home-user-trade/17c10364-8019-48da-af27-038caa7b187a/scratchpad/bt/venvs/item_0/_dl/drivers/drv33.cpp
// Driver for candidate 33 (SarthakDalmia1/backtesting_execution_simulator), public C++ API only:
// ExecutionSimulator(BacktestConfig), set_event_callback, set_slippage_model, set_cost_model,
// add_tick, submit_order, cancel_order, run, matching_engine(), event_queue(), get_last_tick.
// Usage: drv33 <mode> [args]; output: one "key value..." line per observation.
#include "execution/execution_simulator.hpp"
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
using namespace backtest;

static Tick tick_at(Timestamp ts, double px, double qty) {
  Tick t; t.timestamp = ts; t.symbol = Symbol("X");
  t.bid_price = Price::from_double(px); t.ask_price = Price::from_double(px); t.last_price = Price::from_double(px);
  t.bid_size = Quantity::from_double(qty); t.ask_size = Quantity::from_double(qty); t.last_size = Quantity::from_double(qty);
  t.volume = (uint64_t)qty; return t;
}
static OrderRequest req(Side s, OrderType ty, double px, double qty) {
  OrderRequest r; r.symbol = Symbol("X"); r.side = s; r.type = ty; r.price = Price::from_double(px);
  r.quantity = Quantity::from_double(qty); r.tif = TimeInForce::GTC; return r;
}
static const char* tname(EventType t) {
  switch (t) { case EventType::MarketData: return "MarketData"; case EventType::OrderSubmit: return "OrderSubmit";
    case EventType::OrderCancel: return "OrderCancel"; case EventType::OrderFill: return "OrderFill";
    case EventType::OrderReject: return "OrderReject"; case EventType::Trade: return "Trade"; default: return "Other"; }
}
// "ts:price:qty" arguments
struct In { Timestamp ts; double px; double qty; };
static std::vector<In> ins(int argc, char** argv, int from) {
  std::vector<In> v; for (int i = from; i < argc; ++i) { In x; sscanf(argv[i], "%lld:%lf:%lf", (long long*)&x.ts, &x.px, &x.qty); v.push_back(x); } return v;
}

struct FixedPrice : SlippageModel {  // the scene's fill model: fill at 12345.0 whatever the market
  Price calculate_slippage(Price base, Quantity, Quantity, Side, double, double) const override {
    return Price::from_double(12345.0) - base; }
};
struct PerFill : TransactionCostModel {  // 0.5 per fill
  double calculate_cost(double, Quantity, bool, const Symbol&) const override { return 0.5; } };
struct PerUnit : TransactionCostModel {  // 0.375 per unit of quantity
  double calculate_cost(double, Quantity q, bool, const Symbol&) const override { return 0.375 * q.to_double(); } };

int main(int argc, char** argv) {
  if (argc < 2) return 2;
  std::string mode = argv[1];
  BacktestConfig cfg;  // tool defaults unless the mode says otherwise
  if (mode == "md" || mode == "md0") {  // hand ticks, print every MarketData event the callback receives
    if (mode == "md0") cfg.latency.market_data_latency_ns = 0;
    auto v = ins(argc, argv, 2);
    cfg.start_time = v.empty() ? 0 : v[0].ts;
    ExecutionSimulator sim(cfg);
    sim.set_event_callback([&](const Event& e) {
      if (get_event_type(e) == EventType::MarketData) {
        const auto& m = std::get<MarketDataEvent>(e);
        printf("MD %lld %.6f\n", (long long)m.timestamp, m.tick.last_price.to_double()); } });
    for (auto& x : v) sim.add_tick(tick_at(x.ts, x.px, x.qty));
    sim.run(); return 0;
  }
  if (mode == "future") {  // at the MarketData event whose tick time is argv[2], try the reads a strategy has
    Timestamp probe = atoll(argv[2]); cfg.latency.market_data_latency_ns = 0;
    auto v = ins(argc, argv, 3); cfg.start_time = v[0].ts;
    ExecutionSimulator sim(cfg); bool done = false;
    sim.set_event_callback([&](const Event& e) {
      if (done || get_event_type(e) != EventType::MarketData) return;
      const auto& m = std::get<MarketDataEvent>(e); if (m.timestamp != probe) return; done = true;
      const Event* nx = sim.event_queue().peek();
      if (nx && get_event_type(*nx) == EventType::MarketData)
        printf("PEEK %lld %.6f\n", (long long)get_event_timestamp(*nx), std::get<MarketDataEvent>(*nx).tick.last_price.to_double());
      else printf("PEEK none\n");
      const Tick* lt = sim.get_last_tick(Symbol("X"));
      if (lt) printf("LAST %lld %.6f\n", (long long)lt->timestamp, lt->last_price.to_double()); else printf("LAST none\n"); });
    for (auto& x : v) sim.add_tick(tick_at(x.ts, x.px, x.qty));
    sim.run(); return 0;
  }
  // order scenes: argv[2] = order kind (limit90 / market), argv[3] = qty, argv[4] = capital, argv[5] = plug, then ticks
  if (mode == "orders") {
    std::string kind = argv[2]; double qty = atof(argv[3]); cfg.initial_capital = atof(argv[4]); std::string plug = argv[5];
    auto v = ins(argc, argv, 6); cfg.start_time = v[0].ts;
    if (plug == "latency7ms") { cfg.latency.order_submit_latency_ns = 7000000; cfg.latency.market_data_latency_ns = 0;
                                cfg.latency.order_cancel_latency_ns = 0; cfg.latency.fill_report_latency_ns = 0; }
    ExecutionSimulator sim(cfg);
    if (plug == "fill12345") sim.set_slippage_model(std::make_unique<FixedPrice>());
    if (plug == "cost05") sim.set_cost_model(std::make_unique<PerFill>());
    if (plug == "cost0375unit") sim.set_cost_model(std::make_unique<PerUnit>());
    // liquidity: one resting sell at the first trade's price and size (the tool's demo puts a resting order first)
    sim.matching_engine().submit_order(req(Side::Sell, OrderType::Limit, v[0].px, v[0].qty));
    int n = 0; OrderId mine = 0;
    sim.set_event_callback([&](const Event& e) {
      EventType t = get_event_type(e);
      if (t == EventType::MarketData) {
        ++n; printf("CALL %d %lld\n", n, (long long)get_event_timestamp(e));
        if (n == 1) {
          if (kind == "limit90") sim.submit_order(req(Side::Buy, OrderType::Limit, 90.0, qty));
          else sim.submit_order(req(Side::Buy, OrderType::Market, 0.0, qty));
        }
        if (n == 3 && mine) { Order* o = sim.matching_engine().find_order(mine);
          printf("FILLED_AT_3 %.6f\n", o ? o->filled_quantity.to_double() : -1.0); }
      } else if (t == EventType::OrderFill) {
        const auto& f = std::get<OrderFillEvent>(e);
        if (f.fill.side == Side::Buy) { mine = f.fill.order_id;
          printf("FILL %lld %.6f %.6f %.6f\n", (long long)f.timestamp, f.fill.fill_price.to_double(), f.fill.fill_quantity.to_double(), f.transaction_cost); }
      } else if (t == EventType::OrderSubmit) { printf("NOTICE accepted %lld\n", (long long)get_event_timestamp(e));
      } else if (t == EventType::OrderReject) { printf("NOTICE rejected %lld\n", (long long)get_event_timestamp(e));
      } else { printf("EVENT %s %lld\n", tname(t), (long long)get_event_timestamp(e)); }
    });
    for (auto& x : v) sim.add_tick(tick_at(x.ts, x.px, x.qty));
    sim.run();
    printf("CASH %.6f\n", sim.position_manager().cash());
    return 0;
  }
  return 2;
}

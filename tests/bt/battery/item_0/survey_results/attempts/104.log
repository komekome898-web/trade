--- /tmp/claude-0/-home-user-trade/17c10364-8019-48da-af27-038caa7b187a/scratchpad/bt/venvs/item_0/_dl/drivers/drv104.cpp
#include "entries/OrderBookEntry.h"
#include <cstdio>
int main(){
  auto lim = std::make_shared<Limit>(10000); // 価格 100.00 (pence)
  // 先行の 2 本 (50 枚, 30 枚) -> 当方の 10 枚
  auto e1 = std::make_shared<OrderBookEntry>(lim, Order(OrderCore(1,"ahead_A",1), 10000, 50, true));
  lim->AddOrder(e1);
  printf("当方を置く前の先行注文量(GetOrderQuantity)=%u\n", lim->GetOrderQuantity());
  auto e2 = std::make_shared<OrderBookEntry>(lim, Order(OrderCore(2,"ahead_B",1), 10000, 30, true));
  lim->AddOrder(e2);
  printf("当方を置く前の先行注文量(GetOrderQuantity)=%u\n", lim->GetOrderQuantity());
  auto e3 = std::make_shared<OrderBookEntry>(lim, Order(OrderCore(3,"mine",1), 10000, 10, true));
  lim->AddOrder(e3);
  printf("当方を置いた後の合計=%u  本数(GetOrderCount)=%u\n", lim->GetOrderQuantity(), lim->GetOrderCount());
  for (const auto& r : lim->GetOrderRecords())
    printf("  queuePosition=%u orderId=%ld qty=%u px=%ld user=%s\n", r.queuePosition, r.orderId, r.quantity, r.price, r.username.c_str());
  // 先行 A を取り消す -> 当方の待ち行列の順位が上がるか
  auto rm = lim->RemoveOrder(1, 50);
  printf("RemoveOrder(id=1) ok=%d  残り合計=%u\n", (int)rm.has_value(), lim->GetOrderQuantity());
  for (const auto& r : lim->GetOrderRecords())
    printf("  queuePosition=%u orderId=%ld qty=%u user=%s\n", r.queuePosition, r.orderId, r.quantity, r.username.c_str());
  return 0;
}

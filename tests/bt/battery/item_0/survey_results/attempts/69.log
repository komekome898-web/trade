// Driver for candidate 69 gobacktest (github.com/dirkolbrich/gobacktest), public API only:
// Backtest.SetData/SetStrategy/SetPortfolio/SetExchange/Run, Data.SetStream, Bar/Tick data events,
// a StrategyHandler whose OnData records what it receives and returns Signals, Size, CommissionHandler,
// ExecutionHandler, PortfolioHandler. Input: one JSON object on stdin; output: JSON lines.
package main

import (
	"encoding/json"
	"fmt"
	"math"
	"os"
	"time"

	gbt "github.com/dirkolbrich/gobacktest"
	gdata "github.com/dirkolbrich/gobacktest/data"
)

type Ev struct {
	Kind  string  `json:"kind"`
	Ts    int64   `json:"ts_ns"`
	Price float64 `json:"price"`
	Open  float64 `json:"open"`
	High  float64 `json:"high"`
	Low   float64 `json:"low"`
	Close float64 `json:"close"`
	Vol   float64 `json:"volume"`
	Qty   float64 `json:"qty"`
	Bid   float64 `json:"bid"`
	Ask   float64 `json:"ask"`
}

type In struct {
	Mode   string `json:"mode"`
	Dir    string `json:"dir"`
	Events []Ev   `json:"events"`
	Probe  int64  `json:"probe"`
	Plug   string `json:"plug"`
	Qty    int64  `json:"qty"`
	BuyAt  int    `json:"buy_at"`
	ReadAt int    `json:"read_at"`
}

func out(v map[string]interface{}) { b, _ := json.Marshal(v); fmt.Println(string(b)) }

func dataEvent(e Ev) gbt.DataEvent {
	if e.Kind == "tick" {
		t := &gbt.Tick{Bid: e.Bid, Ask: e.Ask}
		t.SetTime(time.Unix(0, e.Ts).UTC())
		t.SetSymbol("X")
		return t
	}
	b := &gbt.Bar{Open: e.Open, High: e.High, Low: e.Low, Close: e.Close, AdjClose: e.Close, Volume: int64(e.Vol)}
	b.SetTime(time.Unix(0, e.Ts).UTC())
	b.SetSymbol("X")
	return b
}

// Rec is the strategy: it records every data event and, at call BuyAt, emits a buy signal.
type Rec struct {
	*gbt.Strategy
	n      int
	in     In
	pf     *gbt.Portfolio
	onCall func(n int, ev gbt.DataEvent, r *Rec)
}

func (r *Rec) OnData(ev gbt.DataEvent) ([]gbt.SignalEvent, error) {
	r.n++
	typ := fmt.Sprintf("%T", ev)
	row := map[string]interface{}{"ev": typ, "ts": ev.Time().UnixNano(), "price": ev.Price(), "n": r.n}
	if b, ok := ev.(*gbt.Bar); ok {
		row["open"], row["high"], row["low"], row["close"], row["volume"] = b.Open, b.High, b.Low, b.Close, b.Volume
	}
	out(row)
	if r.onCall != nil {
		r.onCall(r.n, ev, r)
	}
	if r.in.BuyAt > 0 && r.n == r.in.BuyAt {
		s := &gbt.Signal{}
		s.SetTime(ev.Time())
		s.SetSymbol("X")
		s.SetDirection(gbt.BOT)
		return []gbt.SignalEvent{s}, nil
	}
	return nil, nil
}

// the scene's plugs (a fill model at 12345.0 cannot be written outside the package: Fill has no
// public price setter -- fill.go has SetDirection and SetQty only; see the install record)
type PerFill struct{}

func (PerFill) Calculate(qty, price float64) (float64, error) { return 0.5, nil }

type PerUnit struct{}

func (PerUnit) Calculate(qty, price float64) (float64, error) { return 0.375 * qty, nil }

// RecPortfolio wraps the tool's Portfolio (the PortfolioHandler plug point, Backtest.SetPortfolio): it
// prints every fill handed to the account (fills are not readable otherwise: Portfolio.transactions has no accessor).
type RecPortfolio struct {
	*gbt.Portfolio
	account bool
}

func (p *RecPortfolio) OnFill(f gbt.FillEvent, d gbt.DataHandler) (*gbt.Fill, error) {
	x := f.(*gbt.Fill)
	out(map[string]interface{}{"fill_ts": x.Time().UnixNano(), "fill_price": x.Price(), "fill_qty": x.Qty(), "commission": x.Commission(), "cost": x.Cost(), "account": p.account})
	return p.Portfolio.OnFill(f, d)
}

func main() {
	var in In
	if err := json.NewDecoder(os.Stdin).Decode(&in); err != nil {
		out(map[string]interface{}{"error": err.Error()})
		os.Exit(2)
	}
	if in.Mode == "csv" { // the tool's own CSV loader (data/data-csv.go)
		d := &gdata.BarEventFromCSVFile{FileDir: in.Dir}
		err := d.Load([]string{"X"})
		msg := ""
		if err != nil {
			msg = err.Error()
		}
		times := []int64{}
		for _, e := range d.Stream() {
			times = append(times, e.Time().UnixNano())
		}
		out(map[string]interface{}{"csv_error": msg, "times": times})
		return
	}
	stream := make([]gbt.DataEvent, 0, len(in.Events))
	for _, e := range in.Events {
		stream = append(stream, dataEvent(e))
	}
	data := &gbt.Data{}
	data.SetStream(stream)

	test := gbt.New()
	test.SetSymbols([]string{"X"})
	test.SetData(data)
	pf := gbt.NewPortfolio()
	qty := in.Qty
	if qty == 0 {
		qty = 1
	}
	pf.SetSizeManager(&gbt.Size{DefaultSize: qty, DefaultValue: math.MaxFloat64})
	test.SetPortfolio(&RecPortfolio{Portfolio: pf, account: in.Plug == "account"})
	ex := gbt.NewExchange()
	ex.Symbol = "X"
	switch in.Plug {
	case "cost05":
		ex.Commission = PerFill{}
	case "cost0375unit":
		ex.Commission = PerUnit{}
	}
	test.SetExchange(ex)
	rec := &Rec{Strategy: gbt.NewStrategy("scene"), in: in, pf: pf}
	rec.Strategy.SetChildren(gbt.NewAsset("X"))
	rec.onCall = func(n int, ev gbt.DataEvent, r *Rec) {
		d, _ := r.Data()
		if in.Probe != 0 && ev.Time().UnixNano() == in.Probe {
			hist := d.History()
			mx := -1.0
			for _, h := range hist {
				if h.Price() > mx {
					mx = h.Price()
				}
			}
			out(map[string]interface{}{"visible_count": len(hist), "max_visible_close": mx})
			if st := d.Stream(); len(st) > 0 {
				out(map[string]interface{}{"read": "Data().Stream()[0]", "form": "position", "value": st[0].Price()})
			} else {
				out(map[string]interface{}{"read": "Data().Stream()[0]", "form": "position", "error": "empty"})
			}
			out(map[string]interface{}{"read": "Data().List(\"X\")", "form": "other", "value": len(d.List("X"))})
		}
		if in.ReadAt > 0 && n == in.ReadAt {
			pos, ok := pf.IsInvested("X")
			out(map[string]interface{}{"read_at": n, "invested": ok, "position": fmt.Sprintf("%+v", pos)})
		}
	}
	test.SetStrategy(rec)
	if err := test.Run(); err != nil {
		out(map[string]interface{}{"error": err.Error()})
	}
}

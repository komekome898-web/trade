+			var v interface{}
+			switch nm {
+			case "[n]":
+				v = s[n].Price()
+			case "[n:]":
+				v = prices(s[n:])
+			case "[n:n+1]":
+				v = prices(s[n : n+1])
+			case "[n-1:n+1]":
+				v = prices(s[n-1 : n+1])
+			case "[n:n]":
+				v = prices(s[n:n])
+			}
+			out(map[string]interface{}{"read": name, "form": "position", "shape": "position", "naming": nm, "value": v})
+		}()
+	}
+	for _, nm := range []string{"[n::2]", "[n::-1]", "[:n:-1]"} {
+		out(map[string]interface{}{"read": name, "form": "position", "shape": "position", "naming": nm, "expressible": false})
+	}
+}

+// written by a strategy and are reported as not expressible.
+func tryNamings(name string, s []gbt.DataEvent, n int) {
+	for _, nm := range []string{"[n]", "[n:]", "[n:n+1]", "[n-1:n+1]", "[n:n]"} {
+		func() {
+			defer func() {
+				if r := recover(); r != nil {
+					out(map[string]interface{}{"read": name, "form": "position", "shape": "position", "naming": nm, "error": fmt.Sprint(r)})
+				}

--- /tmp/claude-0/-home-user-trade/17c10364-8019-48da-af27-038caa7b187a/scratchpad/bt/venvs/item_0/_dl/drivers/drv101.cpp
// Minimal driver for candidate 101 (akurkar07/OrderBook): the calls a scene can make.
#include "order_book.h"
#include <cstdio>
using namespace orderbook;
static void dump(const char* tag, const Fills& f){
  printf("%s fills=%zu", tag, f.size());
  for (const auto& x : f) printf(" [px=%.2f qty=%llu buy=%llu sell=%llu]", x.price, (unsigned long long)x.quantity,
                                 (unsigned long long)x.buy_order_id, (unsigned long long)x.sell_order_id);
  printf("\n");
}
int main(){
  OrderBook b;
  dump("place_limit_order(Sell 100.0 x100 id=1)", b.place_limit_order(Order(1, Side::Sell, OrderType::Limit, 100.0, 100)));
  dump("place_market_order(Buy x1 id=2)", b.place_market_order(Order(2, Side::Buy, OrderType::Market, 0.0, 1)));
  dump("place_limit_order(Buy 90.0 x1 id=3)", b.place_limit_order(Order(3, Side::Buy, OrderType::Limit, 90.0, 1)));
  printf("cancel_order(3) -> %d\n", (int)b.cancel_order(3));
  printf("book_empty=%d\n", (int)b.empty());
  return 0;
}

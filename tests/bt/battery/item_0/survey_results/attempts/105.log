--- setup/pyproject:
[build-system]
# 77 is the floor for the SPDX `license` expression and `license-files` below.
# Anything older reads `license = "MIT"` as a legacy table and fails the build.
requires = ["setuptools>=77"]
build-backend = "setuptools.build_meta"

[project]
# The distribution name is not the import name. `slippage` is taken on the index
# by an unrelated project, so this publishes as `slippage-tca` — the suffix names
# what the library is for — while `import slippage` is unchanged. Renaming the
# Python package to match would have broken every existing import for the sake of
# a registry collision.
name = "slippage-tca"
version = "0.1.0"
description = "An optimal execution and transaction cost analysis engine"
readme = "README.md"
requires-python = ">=3.10"
# The legacy `license = { text = "MIT" }` table this replaces put the word MIT in
# the metadata and left the LICENSE file out of the distribution entirely.
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "Daniyal" }]
keywords = [
    "transaction-cost-analysis",
    "optimal-execution",
    "market-impact",
    "implementation-shortfall",
    "almgren-chriss",
    "quantitative-finance",
]
# No `License ::` classifier: it is mutually exclusive with the SPDX expression
# above, and supplying both is an error rather than a duplication.
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Financial and Insurance Industry",
    "Intended Audience :: Science/Research",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3.10",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",

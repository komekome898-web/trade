# One-shot execution-history fetch; scheduled by bitflyer-fetch.timer.
[Unit]
Description=bitFlyer execution history fetch (builds 1-minute candles)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME_USER
WorkingDirectory=/home/CHANGE_ME_USER/trade
ExecStart=/usr/bin/env bash scripts/fetch_all.sh
NoNewPrivileges=true
PrivateTmp=true

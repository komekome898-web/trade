# One-shot execution-history fetch; scheduled by bitflyer-fetch.timer.
[Unit]
Description=bitFlyer execution history fetch (builds 1-minute candles)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME_USER
WorkingDirectory=/home/CHANGE_ME_USER/trade
ExecStart=/home/CHANGE_ME_USER/trade/.venv/bin/python scripts/fetch_history.py
NoNewPrivileges=true
PrivateTmp=true

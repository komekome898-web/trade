{
  "_停止の記録": "2026-09-13、オーナー指示「フックを一回とめろ」(L-160)により、止める力を持つ 3 つの関門(行動の関門 Bash / 同 MCP / 指紋の照合 Write|Edit|Agent / 返答の関門 Stop)を外した。git 側の pre-push も core.hooksPath を外して停止した。**リードの判断で戻さない。**戻すときは下の _停止前の設定 を hooks に戻し、sh scripts/install_git_hooks.sh を実行し、sh scripts/regen_hook_manifest.sh を走らせる。表示のみの 6 本はそのまま動かしてある。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent_delegation_reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prereg_source_reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/git_push_audit_reminder.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget_delegation_reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start_digest.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/owner_turn_digest.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "_停止前の設定": {
    "PreToolUse に戻すもの": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/action_audit_gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/action_audit_gate.sh --mcp"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/_verify_manifest.sh"
          }
        ]
      }
    ],
    "Stop に戻すもの": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/reply_audit_gate.sh"
          }
        ]
      }
    ]
  }
}

# Copy to .env and fill in. NEVER commit .env.
# bitFlyer API key must have ONLY: account read + trade permissions. NO withdrawal permission.
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# Trading mode. PAPER_MODE is the default and the safe mode.
# LIVE_MODE=true alone is NOT enough to trade real money: config.yaml must also
# contain live_mode_ack: "I_UNDERSTAND_REAL_MONEY". Both are required.
PAPER_MODE=true
LIVE_MODE=false

# Optional Discord webhook URL for alerts/status reports
DISCORD_WEBHOOK_URL=

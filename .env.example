# Copy to .env and fill in. NEVER commit .env.
# bitFlyer API key must have ONLY: account read + trade permissions. NO withdrawal permission.
BITFLYER_API_KEY=
BITFLYER_API_SECRET=

# Trading mode. PAPER_MODE is the default and the safe mode.
# LIVE_MODE=true alone is NOT enough to trade real money: config.yaml must also
# contain live_mode_ack: "I_UNDERSTAND_REAL_MONEY". Both are required.
PAPER_MODE=true
LIVE_MODE=false

# Optional Discord webhook URL for alerts/status reports
DISCORD_WEBHOOK_URL=

# kabu STATION API password (ON1 / JPX micro futures, docs/ON1_LIVE_PLAN.md).
# Read from here only; never from YAML, never logged.
KABU_API_PASSWORD=

# ON1 live gate. ON1_LIVE=true alone is NOT enough: config/on1_live.yaml must
# also have enabled: true AND live_ack: "I_UNDERSTAND_REAL_MONEY_JPX".
# Anything less is a dry run (payload written to data/on1_live/events.jsonl).
ON1_LIVE=false

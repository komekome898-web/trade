+def test_cancel_all_active_leaves_the_kept_ids_on_the_book(manager, store,
+                                                           gateway):
+    """The kill switch after a close let through a loss limit (owner L-549):
+    the close it just sent is kept, everything else is cancelled."""
+    kept = manager.submit(symbol="XRP_JPY", side="SELL", size=10.0,
+                          opening=False)
+    # a second resting order (the duplicate guard is bypassed to plant it)
+    real_active = store.active_orders
+    store.active_orders = lambda symbol=None: []
+    try:
+        planted = store.create("XRP_JPY", "BUY", 5.0, "LIMIT", 100.0)
+    finally:
+        store.active_orders = real_active
+    other = store.transition(planted.local_id, OrderState.SUBMITTED,
+                             acceptance_id="ACC-OTHER")
+    canceled = manager.cancel_all_active("XRP_JPY", keep=[kept.local_id])
+    assert [o.local_id for o in canceled] == [other.local_id]
+    assert gateway.canceled == ["ACC-OTHER"]
+    assert store.get(kept.local_id).state is OrderState.SUBMITTED
+

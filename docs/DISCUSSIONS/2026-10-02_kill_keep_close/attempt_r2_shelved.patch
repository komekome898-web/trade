+def test_a_close_let_through_the_loss_limit_is_not_cancelled_by_its_own_trip(
+        tmp_path, monkeypatch):
+    """Owner L-549 / L-550 "通す", on LIVE. A pure close past the daily loss
+    limit is sent first and the switch trips right after. LIVE closes can REST
+    on the book (no immediate fill), and the kill switch's blanket cancel used
+    to take the close it had just let through straight back off the book — the
+    "通す" did not hold on LIVE. The close stays; any OTHER order left on the
+    book is still cancelled, exactly as before."""
+    app, session = _live_app(tmp_path, monkeypatch)
+    _reconciled(app)
+    _cancel_ok(session)
+    app.checker.enforce_loss_limits = True       # the LIVE rule (L-552)
+    sent_alerts = []
+    app.notifier = types.SimpleNamespace(
+        send=lambda title, msg, urgent=False: sent_alerts.append((title, msg)))
+
+    # a real long 0.01 @ 11,000,000, discovered and booked by the sweep
+    entry = app.store.create("FX_BTC_JPY", "BUY", 0.01, "LIMIT", 11_000_000)
+    app.store.transition(entry.local_id, OrderState.SUBMITTED,
+                         acceptance_id="ACC-ENTRY")
+    session.set("GET", "/v1/me/getchildorders",
+                _listing(acc="ACC-ENTRY", state="COMPLETED", executed=0.01,
+                         avg=11_000_000))
+    app._last_order_sweep = -1e9
+    app._sweep_open_orders()
+    assert app.portfolio.position_size == pytest.approx(0.01)
+
+    # -7,000 JPY on the day against MAX_DAILY_LOSS_JPY 6,000
+    mark = 10_300_000.0
+    tick = _tick(mark, spread=0.0)
+    app.feed.last_tick = tick
+    assert app.portfolio.daily_pnl_jpy(mark) <= -6000
+
+    # Another order is on the book next to the close when the trip lands. The
+    # store's duplicate guard would refuse to create it, so it is planted
+    # right after the close is sent (guard bypassed for that one insert).
+    other = {}
+    real_submit = app.orders.submit
+
+    def submit_then_plant(**kw):
+        order = real_submit(**kw)
+        with monkeypatch.context() as m:
+            m.setattr(app.store, "active_orders", lambda symbol=None: [])
+            planted = app.store.create("FX_BTC_JPY", "BUY", 0.01, "LIMIT",
+                                       10_000_000)
+        other["order"] = app.store.transition(
+            planted.local_id, OrderState.SUBMITTED, acceptance_id="ACC-OTHER")
+        return order
+    monkeypatch.setattr(app.orders, "submit", submit_then_plant)
+
+    session.set("POST", ORDER_PATH,
+                FakeResponse(200, {"child_order_acceptance_id": "ACC-CLOSE"}))
+    session.set("GET", "/v1/me/getchildorders", [
+        # 1. the post-submit refresh: the close RESTS, nothing executed
+        _listing(acc="ACC-CLOSE", state="ACTIVE", executed=0.0, avg=0,
+                 side="SELL", size=0.01),
+        # 2. the kill switch's cancel settles the other order
+        _listing(acc="ACC-OTHER", state="CANCELED", executed=0.0, avg=0,
+                 side="BUY", size=0.01),
+    ])
+
+    close = app._try_order("SELL", tick, size=0.01)
+
+    # the close went out and the switch tripped after it (L-549)
+    assert close is not None
+    assert app.kill_switch.state["reason"] == "daily_loss_limit"
+    # the close is still on the book: no cancel was sent for it
+    assert app.store.get(close.local_id).state is OrderState.SUBMITTED
+    cancels = [c for c in session.order_calls() if "cancelchildorder" in c["path"]]
+    assert len(cancels) == 1
+    assert "ACC-OTHER" in str(cancels[0]["data"])
+    assert "ACC-CLOSE" not in str(cancels[0]["data"])
+    # the other order was cancelled, as every kill switch did before
+    assert app.store.get(other["order"].local_id).state is OrderState.CANCELED
+    # the operator is told the close is resting, not "the bot will not close it"
+    title, msg = sent_alerts[-1]
+    assert title == "KILL SWITCH"
+    assert "ACC-CLOSE" in msg

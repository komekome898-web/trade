+def test_a_kept_close_that_fills_while_tripped_is_booked(tmp_path, monkeypatch):
+    """(critic, stop) The kept close RESTS, the switch trips, and the venue
+    fills it a cycle later. A tripped bot keeps reading (owner L-532), and the
+    kept order is read back like any other data: its fill is booked, the
+    book and status.json go flat, and the watch stops once it is done. Read
+    only: nothing is sent or cancelled while tripped."""
+    app, session, alerts, tick = _loss_limit_close_app(tmp_path, monkeypatch)
+    session.set("POST", ORDER_PATH,
+                FakeResponse(200, {"child_order_acceptance_id": "ACC-CLOSE"}))
+    session.set("GET", "/v1/me/getchildorders", _close_row("ACTIVE", 0.0))
+    close = app._try_order("SELL", tick, size=0.01)
+    assert app.kill_switch.is_tripped
+    assert app.store.get(close.local_id).state is OrderState.SUBMITTED
+    assert app.portfolio.position_size == pytest.approx(0.01)
+
+    session.set("GET", "/v1/me/getchildorders", _close_row("COMPLETED", 0.01))
+    app._last_kept_watch = -1e9
+    app.step()                                      # a tripped cycle
+
+    assert app.store.get(close.local_id).state is OrderState.FILLED
+    assert app.portfolio.position_size == pytest.approx(0.0)
+    assert app.status.status.position_size == pytest.approx(0.0)
+    assert [c for c in session.order_calls() if ORDER_PATH in c["path"]] \
+        and len([c for c in session.order_calls()
+                 if ORDER_PATH in c["path"]]) == 1   # nothing re-sent
+    assert _cancel_calls(session) == []
+    # done: the next tripped cycle does not read it again
+    reads = len([c for c in session.calls if "getchildorders" in c["path"]])
+    app._last_kept_watch = -1e9
+    app.step()
+    assert len([c for c in session.calls
+                if "getchildorders" in c["path"]]) == reads
+

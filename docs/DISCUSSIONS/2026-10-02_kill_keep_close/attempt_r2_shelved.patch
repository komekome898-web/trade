+def _loss_limit_close_app(tmp_path, monkeypatch, reconciler=False):
+    """A LIVE app holding a booked long 0.01 @ 11,000,000 at a mark of
+    10,300,000: -7,000 JPY on the day against MAX_DAILY_LOSS_JPY 6,000, so a
+    SELL 0.01 is a pure close the checks let through and trip after (L-549)."""
+    app, session = _live_app(tmp_path, monkeypatch)
+    if reconciler:
+        _reconciled(app)
+    else:
+        app.orders._reconciler = None
+    _cancel_ok(session)
+    app.checker.enforce_loss_limits = True
+    alerts = []
+    app.notifier = types.SimpleNamespace(
+        send=lambda title, msg, urgent=False: alerts.append((title, msg)))
+    entry = app.store.create("FX_BTC_JPY", "BUY", 0.01, "LIMIT", 11_000_000)
+    app.store.transition(entry.local_id, OrderState.SUBMITTED,
+                         acceptance_id="ACC-ENTRY")
+    session.set("GET", "/v1/me/getchildorders",
+                _listing(acc="ACC-ENTRY", state="COMPLETED", executed=0.01,
+                         avg=11_000_000))
+    app._last_order_sweep = -1e9
+    app._sweep_open_orders()
+    tick = _tick(10_300_000.0, spread=0.0)
+    app.feed.last_tick = tick
+    return app, session, alerts, tick
+
+
+def _close_row(state, executed):
+    return _listing(acc="ACC-CLOSE", state=state, executed=executed,
+                    avg=10_300_000, side="SELL", size=0.01)
+
+
+def _cancel_calls(session):
+    return [c for c in session.order_calls() if "cancelchildorder" in c["path"]]
+

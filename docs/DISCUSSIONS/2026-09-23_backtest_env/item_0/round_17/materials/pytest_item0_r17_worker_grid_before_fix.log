            v, w, node = root, where, opened
            while True:
                if node is not None:  # enter the container v
                    key = id(v)
                    if key in path:
                        raise fail(_CYCLE, v, w)
                    if outer + len(path) >= MAX_NESTING:
                        raise fail(_DEEP, v, w)

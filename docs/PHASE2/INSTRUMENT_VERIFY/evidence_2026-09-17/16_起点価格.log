  |             f_m = f"{statistics.mean(frag):+.3f}(n={len(frag)})" if frag else "なし"
  |             w_m = f"{statistics.mean(whole):+.3f}(n={len(whole)})" if whole else "なし"
  |             km = out["keep"]["mean"]
  |             dm = out["drop"]["mean"]

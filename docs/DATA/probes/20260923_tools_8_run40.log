== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/array/arraycompare.txt
     1	ArrayCompare
     2	The function returns the result of comparing two arrays of the same type. It can be used to compare arrays of simple types or custom structures without complex objects, that is the custom structures that do not contain strings, dynamic arrays, classes and other structures with complex objects.
     3	
     4	
     5	int  ArrayCompare(
     6	   const void&  array1[],            // first array
     7	   const void&  array2[],            // second array
     8	   int          start1=0,            // initial offset in the first array
     9	   int          start2=0,            // initial offset in the second array
    10	   int          count=WHOLE_ARRAY    // number of elements for comparison
    11	   );
    12	
    13	
    14	
    15	
    16	Parameters
    17	array1[]
    18	[in]  First array.
    19	array2[]
    20	[in]  Second array.
    21	start1=0
    22	[in]  The element's initial index in the first array, from which comparison starts. The default start index - 0.
    23	start2=0
    24	[in]  The element's initial index in the second array, from which comparison starts. The default start index - 0.
    25	count=WHOLE_ARRAY
    26	[in]  Number of elements to be compared. All elements of both arrays participate in comparison by default (count=WHOLE_ARRAY).
    27	Return Value
    28	
    29	-1, if array1[] less than array2[]
    30	0, if array1[] equal to array2[]
    31	1, if array1[] more than array2[]
    32	-2, if an error occurs due to incompatibility of the types of compared arrays or if start1, start2 or count values lead to falling outside the array.
    33	
    34	Note
    35	The function will not return 0 (the arrays will not be considered equal) if the arrays differ in size and count=WHOLE_ARRAY for the case when one array is a faithful subset of another one. In this case, the result of comparing the sizes of that arrays will be returned: -1, if the size of array1[] is less than the size of array2[] , otherwise 1.
    36	
    37	Example:
    38	
    39	
    40	//--- global variables 
    41	double   ExtArrayFirst[];
    42	double   ExtArraySecond[];
    43	 
    44	//+------------------------------------------------------------------+
    45	//| Script program start function                                    |
    46	//+------------------------------------------------------------------+
    47	void OnStart()
    48	  {
    49	//--- set the array sizes
    50	   if(ArrayResize(ExtArrayFirst,10)!=10)
    51	     {
    52	      Print("ArrayResize() failed for ExtArrayFirst. Error code: ",GetLastError());
    53	      return;
    54	     }
    55	   if(ArrayResize(ExtArraySecond,10)!=10)
    56	     {
    57	      Print("ArrayResize() failed for ExtArraySecond. Error code: ",GetLastError());
    58	      return;
    59	     }
    60	     
    61	//--- fill the arrays with the values of i and j indices in a loop
    62	   int total=ArraySize(ExtArrayFirst);
    63	   for(int i=0, j=total-1; i<total; i++,j--)
    64	     {
    65	      //--- fill the ExtArrayFirst array from left to right
    66	      //--- fill the ExtArraySecond array from right to left
    67	      ExtArrayFirst[i]=i;
    68	      ExtArraySecond[i]=j;
    69	     }
    70	//--- compare the arrays and print the result in the log
    71	   ArrayComparePrint(ExtArrayFirst,ExtArraySecond);
    72	   /*
    73	   Result:
    74	   ExtArrayFirst:
    75	   0.00000 1.00000 2.00000 3.00000 4.00000 5.00000 6.00000 7.00000 8.00000 9.00000
    76	   ExtArraySecond:
    77	   9.00000 8.00000 7.00000 6.00000 5.00000 4.00000 3.00000 2.00000 1.00000 0.00000
    78	   Result ArrayCompare(): ExtArrayFirst is smaller than ExtArraySecond (result = -1)
    79	   */
    80	   
    81	//--- now let's flip the arrays
    82	//--- fill the arrays with the values of i and j indices in a loop
    83	   for(int i=0, j=total-1; i<total; i++,j--)
    84	     {
    85	      //--- fill the ExtArrayFirst array from right to left
    86	      //--- fill the ExtArraySecond array from left to right
    87	      ExtArrayFirst[i]=j;
    88	      ExtArraySecond[i]=i;
    89	     }
    90	//--- compare the arrays and print the result in the log
    91	   ArrayComparePrint(ExtArrayFirst,ExtArraySecond);
    92	   /*
    93	   Result:
    94	   ExtArrayFirst:
    95	   9.00000 8.00000 7.00000 6.00000 5.00000 4.00000 3.00000 2.00000 1.00000 0.00000
    96	   ExtArraySecond:
    97	   0.00000 1.00000 2.00000 3.00000 4.00000 5.00000 6.00000 7.00000 8.00000 9.00000
    98	   Result ArrayCompare(): ExtArrayFirst is larger than ExtArraySecond (result = 1)
    99	   */
   100	   
   101	//--- now let's fill the arrays in one direction
   102	//--- fill the arrays with the values of i index in a loop
   103	   for(int i=0; i<total; i++)
   104	     {
   105	      //--- fill both arrays from left to right
   106	      ExtArrayFirst[i]=i;
   107	      ExtArraySecond[i]=i;
   108	     }
   109	//--- compare the arrays and print the result in the log
   110	   ArrayComparePrint(ExtArrayFirst,ExtArraySecond);
   111	   /*
   112	   Result:
   113	   ExtArrayFirst:
   114	   0.00000 1.00000 2.00000 3.00000 4.00000 5.00000 6.00000 7.00000 8.00000 9.00000
   115	   ExtArraySecond:
   116	   0.00000 1.00000 2.00000 3.00000 4.00000 5.00000 6.00000 7.00000 8.00000 9.00000
   117	   Result ArrayCompare(): ExtArrayFirst and ExtArraySecond are equal (result = 0)
   118	   */
   119	  }
   120	//+------------------------------------------------------------------+
   121	//| Compare and display the result                                   |
   122	//+------------------------------------------------------------------+
   123	void ArrayComparePrint(const double &array1[], const double &array2[])
   124	  {
   125	   //--- print the header and contents of the arrays
   126	   Print("ExtArrayFirst:");
   127	   ArrayPrint(array1);
   128	   Print("ExtArraySecond:");
   129	   ArrayPrint(array2);
   130	   //--- compare the arrays and print the comparison result
   131	   int    res=ArrayCompare(array1,array2);
   132	   string res_str=(res>0 ? "ExtArrayFirst is larger than ExtArraySecond" : res<0 ? "ExtArrayFirst is smaller than ExtArraySecond" : "ExtArrayFirst and ExtArraySecond are equal");
   133	   PrintFormat("Result ArrayCompare(): %s (result = %d)\n",res_str,res);
   134	  }
   135	//+------------------------------------------------------------------+

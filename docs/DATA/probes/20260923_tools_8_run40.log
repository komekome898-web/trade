== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/matrix/matrix_manipulations/matrix_comparebydigits.txt
     1	CompareByDigits
     2	Compare the elements of two matrices/vectors with the significant digits precision.
     3	
     4	
     5	ulong vector::CompareByDigits(
     6	  const vector& vec,          // vector to compare
     7	  const int     digits        // number of significant digits
     8	   );
     9	 
    10	ulong matrix::CompareByDigits(
    11	  const matrix& mat,          // matrix to compare
    12	  const int     digits        // number of significant digits
    13	   );
    14	
    15	
    16	
    17	
    18	
    19	Parameters
    20	vec
    21	[in]  Vector to compare.
    22	mat
    23	[in]  Matrix to compare.
    24	digits
    25	[in] Number of significant digits to compare.
    26	Return Value
    27	The number of mismatched elements of the matrices or vectors being compared: 0 if the matrices are equal, greater than 0 otherwise.
    28	Note
    29	The comparison operators == or != execute an exact element-wise comparison. It is known that the exact comparison of real numbers is of limited use, so the epsilon comparison method was added. It may happen that one matrix can contain elements in a range, for example from 1e-20 to 1e+20. Such matrices can be processed using element-wise comparison up to significant digits.
    30	
    31	Example
    32	
    33	
    34	   int    size_m=128;
    35	   int    size_k=256;
    36	   matrix matrix_a(size_m,size_k);
    37	//--- fill the matrix
    38	   double  value=0.0;
    39	   for(int i=0; i<size_m; i++)
    40	     {
    41	      for(int j=0; j<size_k; j++)
    42	        {
    43	         if(i==j)
    44	            matrix_a[i][j]=1.0+i;
    45	         else
    46	           {
    47	            value+=1.0;
    48	            matrix_a[i][j]=value/1e+20;
    49	           }
    50	        }
    51	     }
    52	//--- get another matrix
    53	   matrix matrix_c = matrix_a * -1;
    54	 
    55	   ulong errors_epsilon=matrix_a.Compare(matrix_c,1e-15);
    56	   ulong errors_digits=matrix_a.CompareByDigits(matrix_c,15);
    57	 
    58	   printf("Compare matrix %d x %d  errors_epsilon=%I64u  errors_digits=%I64u",size_m,size_k,errors_epsilon,errors_digits);
    59	 
    60	 
    61	  /*
    62	  Compare matrix 128 x 256  errors_epsilon=128  errors_digits=32768
    63	  */

    93	#include <Math\Fuzzy\membershipfunction.mqh>
    94	#include <Graphics\Graphic.mqh>
    95	//--- Create membership functions
    96	CDifferencTwoSigmoidalMembershipFunction func1(5,1,8,7);
    97	CDifferencTwoSigmoidalMembershipFunction func2(5,4,5,7);
    98	CDifferencTwoSigmoidalMembershipFunction func3(5,6,2,7);
    99	//--- Create wrappers for membership functions
   100	double DifferencTwoSigmoidalMembershipFunction1(double x) { return(func1.GetValue(x)); }
   101	double DifferencTwoSigmoidalMembershipFunction2(double x) { return(func2.GetValue(x)); }
   102	double DifferencTwoSigmoidalMembershipFunction3(double x) { return(func3.GetValue(x)); }
   103	//+------------------------------------------------------------------+
   104	//| Script program start function                                    |
   105	//+------------------------------------------------------------------+
   106	void OnStart()
   107	  {
   108	//--- create graphic
   109	   CGraphic graphic;
   110	   if(!graphic.Create(0,"DifferencTwoSigmoidalMembershipFunction",0,30,30,780,380))
   111	     {
   112	      graphic.Attach(0,"DifferencTwoSigmoidalMembershipFunction");
   113	     }
   114	   graphic.HistoryNameWidth(70);
   115	   graphic.BackgroundMain("DifferencTwoSigmoidalMembershipFunction");
   116	   graphic.BackgroundMainSize(16);
   117	//--- create curve
   118	   graphic.CurveAdd(DifferencTwoSigmoidalMembershipFunction1,0.0,10.0,0.1,CURVE_LINES,"[5, 1, 8, 7]");
   119	   graphic.CurveAdd(DifferencTwoSigmoidalMembershipFunction2,0.0,10.0,0.1,CURVE_LINES,"[5, 4, 5, 7]");
   120	   graphic.CurveAdd(DifferencTwoSigmoidalMembershipFunction3,0.0,10.0,0.1,CURVE_LINES,"[5, 6, 2, 7]");
   121	//--- sets the X-axis properties
   122	   graphic.XAxis().AutoScale(false);
   123	   graphic.XAxis().Min(0.0);
   124	   graphic.XAxis().Max(10.0);
   125	   graphic.XAxis().DefaultStep(1.0);
   126	//--- sets the Y-axis properties
   127	   graphic.YAxis().AutoScale(false);
   128	   graphic.YAxis().Min(0.0);
   129	   graphic.YAxis().Max(1.1);
   130	   graphic.YAxis().DefaultStep(0.2);
   131	//--- plot
   132	   graphic.CurvePlotAll();
   133	   graphic.Update();
   134	  }

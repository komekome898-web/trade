     1	MathCompareByDigits
     2	Compares two numbers for equality to the specified number of significant digits.
     3	
     4	
     5	bool MathCompareByDigits(
     6	 const double value1, // first number
     7	 const double value2, // second number
     8	 const int digits // number of significant digits
     9	 );
    10	 
    11	bool MathCompareByDigits(
    12	 const float value1, // first number
    13	 const float value2, // second number
    14	 const int digits // number of significant digits
    15	 );
    16	 
    17	bool MathCompareByDigits(
    18	 const complex value1, // first number
    19	 const complex value2, // second number
    20	 const int digits // number of significant digits
    21	 );
    22	 
    23	bool MathCompareByDigits(
    24	 const complexf value1, // first number
    25	 const complexf value2, // second number
    26	 const int digits // number of significant digits
    27	 );
    28	
    29	
    30	
    31	
    32	Parameters
    33	value1
    34	[in] First number to compare.
    35	value2
    36	[in] Second number to compare.
    37	digits
    38	[in] Number of significant digits to compare.
    39	Return Value
    40	Returns true if the compared numbers match to digits significant digits. Otherwise, returns false.
    41	Note
    42	The function is useful when the order of magnitude of the compared numbers is not known in advance, and also for complex numbers whose real and imaginary parts can differ significantly in magnitude. In other cases, it is better to use epsilon-based comparison.
    43	If one of the values is 0, comparison is not performed. In this case, use epsilon-based comparison. For complex numbers, real and imaginary parts are compared pairwise.
    44	

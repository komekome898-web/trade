== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/matrix/matrix_manipulations/compareequal.txt
     1	CompareEqual
     2	Perform an absolute comparison of two matrices by unfolding successive rows into one-dimensional vectors.
     3	
     4	
     5	int vector::Compare(
     6	  const vector& vec    // vector to compare
     7	   );
     8	 
     9	int matrix::CompareEqual(
    10	  const matrix& mat     // matrix to compare
    11	   );
    12	
    13	
    14	
    15	
    16	Parameters
    17	vec
    18	[in]  Vector to compare.
    19	mat
    20	[in]  Matrix to compare.
    21	Method description
    22	Let us have two matrices: matrix A the method is called for and matrix B, which is passed as a method parameter. The comparison is performed as follows:
    23	
    24	Matrices are expanded into one-dimensional vectors by successive concatenation of rows.
    25	Vectors are compared element by element until the first mismatched element.
    26	Depending on the comparison results, one of the values described below is returned.
    27	
    28	Return Value
    29	-1 — if the matrix A element is less than the corresponding matrix B element.
    30	0 — if all elements of A and B matrices are identical.
    31	1 — if the matrix A element exceeds the corresponding matrix B element.
    32	
    33	Note
    34	NaN value elements are taken into account when comparing.
    35	NaN value elements are considered equal if they are present in both matrices at corresponding positions.
    36	The NaN sign is not taken into account in the comparison.
    37	An element with a NaN value is considered to be less than any other numeric value.
    38	
    39	Example
    40	
    41	
    42	//+------------------------------------------------------------------+
    43	//| Script program start function                                    |
    44	//+------------------------------------------------------------------+
    45	void OnStart()
    46	  {
    47	//---
    48	   matrix matrix_a= {{10, 3, 2}, {1, 8, 12}, {6, 5, 4}};
    49	   matrix matrix_i=matrix::Identity(3, 3);
    50	   matrix matrix_c=matrix_a.Inv();
    51	   matrix matrix_check=matrix_a.MatMul(matrix_c);
    52	   Print("matrix_check\n", matrix_check);
    53	 
    54	   ulong errors=matrix_check.Compare(matrix::Identity(3, 3), 1e-15);
    55	   Print("errors=", errors);
    56	   /*
    57	   matrix_check
    58	   [[1,0,0]
    59	   [4.440892098500626e-16,1,8.881784197001252e-16]
    60	   [4.440892098500626e-16,2.220446049250313e-16,0.9999999999999996]]
    61	   errors=0
    62	   */
    63	 
    64	//---  absolute comparison of matrices 
    65	   matrix<double> A = matrix_a;  // Matrix A initialization
    66	   matrix<double> B = matrix_c;  // Matrix B initialization
    67	   int result = A.CompareEqual(B);
    68	   switch(result)
    69	     {
    70	      case -1:
    71	         Print("Matrix A is smaller than matrix B");
    72	         break;
    73	      case 0:
    74	         Print("Matrices A and B are identical");
    75	         break;
    76	      case 1:
    77	         Print("Matrix A is greater than matrix B");
    78	         break;
    79	      case -2:
    80	         Print("Error! Matrix A is not initialized");
    81	         break;
    82	      case 2:
    83	         Print("Error! Matrix B is not initialized");
    84	         break;
    85	      case -3:
    86	         Print("Error! The size of matrix A is less than the size of matrix B");
    87	         break;
    88	      case 3:
    89	         Print("Error! The size of matrix A is greater than the size of matrix B");
    90	         break;
    91	      default:
    92	         Print("Error! Unknown error");
    93	         break;
    94	     }
    95	  }
    96	

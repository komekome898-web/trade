== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/standardlibrary/cobject/cobjectcompare.txt
     1	Compare
     2	Compares the data on a list element with data on another list element.
     3	
     4	
     5	virtual int  Compare(
     6	   const CObject*  node,     // element
     7	   const int       mode=0    // variant
     8	   ) const
     9	
    10	
    11	
    12	
    13	Parameters
    14	node
    15	[in]  Pointer to a list element to compare
    16	mode=0
    17	[in]  Comparison variant
    18	Return Value
    19	0 - in case the list elements are equal, -1 - if the list element is less than the element used for comparison (node), 1 - if the list element is greater than the element used for comparison (node).
    20	Note
    21	Compare() method in CObject class always returns 0 and does not perform any action. If you want to compare data in derived class, the Compare(...) method should be implemented. The 'mode' parameter should be used when implementing multivariate comparison.
    22	Example:
    23	
    24	
    25	//--- example for CObject::Compare(...)
    26	#include <Object.mqh>
    27	//---
    28	void OnStart()
    29	  {
    30	   CObject *object_first,*object_second;
    31	   //---
    32	   object_first=new CObject;
    33	   if(object_first==NULL)
    34	     {
    35	      printf("Object create error");
    36	      return;
    37	     }
    38	   object_second=new CObject;
    39	   if(object_second==NULL)
    40	     {
    41	      printf("Object create error");
    42	      delete object_first;
    43	      return;
    44	     }
    45	   //--- set interconnect
    46	   object_first.Next(object_second);
    47	   object_second.Prev(object_first);
    48	   //--- compare objects
    49	   int result=object_first.Compare(object_second);
    50	   //--- delete objects
    51	   delete object_first;
    52	   delete object_second;
    53	  }

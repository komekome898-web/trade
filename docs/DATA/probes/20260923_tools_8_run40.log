== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/strings/stringcompare.txt
     1	StringCompare
     2	The function compares two strings and returns the comparison result in form of an integer.
     3	
     4	
     5	int  StringCompare(
     6	   const string&  string1,                 // the first string in the comparison
     7	   const string&  string2,                 // the second string in the comparison
     8	   bool           case_sensitive=true      // case sensitivity mode selection for the comparison
     9	   );
    10	
    11	
    12	
    13	
    14	Parameters
    15	string1
    16	[in]  The first string.
    17	string2
    18	[in]  The second string.
    19	case_sensitive=true
    20	[in]  Case sensitivity mode selection. If it is true, then "A">"a". If it is false, then "A"="a". By default the value is equal to true.
    21	Return Value
    22	
    23	-1 (minus one), if string1<string2
    24	0 (zero), if string1=string2
    25	1 (one), if string1>string2
    26	
    27	Note
    28	The strings are compared symbol by symbol, the symbols are compared in the alphabetic order in accordance with the current code page.
    29	Example:
    30	
    31	
    32	void OnStart()
    33	  {
    34	//--- what is larger - apple or home?
    35	   string s1="Apple";
    36	   string s2="home";
    37	
    38	 
    39	
    40	//--- compare case sensitive 
    41	   int result1=StringCompare(s1,s2);
    42	   if(result1>0) PrintFormat("Case sensitive comparison: %s > %s",s1,s2);
    43	   else
    44	     {
    45	      if(result1<0)PrintFormat("Case sensitive comparison: %s < %s",s1,s2);
    46	      else PrintFormat("Case sensitive comparison: %s = %s",s1,s2);
    47	     }
    48	
    49	 
    50	
    51	//--- compare case-insensitive
    52	   int result2=StringCompare(s1,s2,false);
    53	   if(result2>0) PrintFormat("Case insensitive comparison: %s > %s",s1,s2);
    54	   else
    55	     {
    56	      if(result2<0)PrintFormat("Case insensitive comparison: %s < %s",s1,s2);
    57	      else PrintFormat("Case insensitive comparison: %s = %s",s1,s2);
    58	     }
    59	/* Result
    60	     Case-sensitive comparison: Apple < home
    61	     Case insensitive comparison: Apple < home
    62	*/
    63	  }
    64	
    65	
    66	
    67	
    68	See also
    69	String Type, CharToString(), ShortToString(), StringToCharArray(), StringToShortArray(), StringGetCharacter(), Use of a Codepage

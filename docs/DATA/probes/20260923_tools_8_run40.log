== /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-029/text/www.mql5.com/en/docs/matrix/matrix_manipulations/matrix_compare.txt
     1	Compare
     2	Compare the elements of two matrices/vectors with the specified precision.
     3	
     4	
     5	ulong vector::Compare(
     6	  const vector& vec,         // vector to compare
     7	  const double  epsilon       // precision
     8	   );
     9	 
    10	ulong matrix::Compare(
    11	  const matrix& mat,          // matrix to compare
    12	  const double  epsilon       // precision
    13	   );
    14	
    15	
    16	
    17	
    18	Parameters
    19	vec
    20	[in]  Vector to compare.
    21	mat
    22	[in]  Matrix to compare.
    23	epsilon
    24	[in]  Precision.
    25	Return Value
    26	The number of mismatched elements of the matrices or vectors being compared: 0 if the matrices are equal, greater than 0 otherwise.
    27	
    28	Note
    29	The comparison operators == or != execute an exact element-wise comparison. It is known that the exact comparison of real numbers is of limited use, so the epsilon comparison method was added. It may happen that one matrix can contain elements in a range, for example from 1e-20 to 1e+20. Such matrices can be processed using element-wise comparison up to significant figures.
    30	For complex matrices/vectors, the comparison involves estimating the distance between complex numbers. The distance is calculated as sqrt(pow(r1-r2, 2) + pow(i1-i2, 2) and is a real number that can already be compared with epsilon.
    31	 
    32	Example
    33	
    34	
    35	   matrix matrix_a={{10,3,2},{1,8,12},{6,5,4}};
    36	   matrix matrix_i=matrix::Identity(3,3);
    37	   matrix matrix_c=matrix_a.Inv();
    38	   matrix matrix_check=matrix_a.MatMul(matrix_c);
    39	   Print("matrix_check\n",matrix_check);
    40	 
    41	   ulong errors=matrix_check.Compare(matrix::Identity(3,3),1e-15);
    42	   Print("errors=",errors);
    43	 
    44	 
    45	  /*
    46	  matrix_check
    47	  [[1,0,0]
    48	  [4.440892098500626e-16,1,8.881784197001252e-16]
    49	  [4.440892098500626e-16,2.220446049250313e-16,0.9999999999999996]]
    50	  errors=0
    51	 
    52	  */

declare -A PV=( [purgedcv]=0.1.8 [numpy]=2.5.3 [pandas]=3.0.6 [scikit-learn]=1.9.1 [scipy]=1.18.1 [python-dateutil]=2.9.0.post0 [joblib]=1.6.0 [threadpoolctl]=3.7.0 [narwhals]=2.26.0 [six]=1.17.0 [cloudpickle]=3.1.2 )
for pkg in "${!PV[@]}"; do
  ver=${PV[$pkg]}

  python3 -c "
import json,sys,hashlib,glob,os
d = json.loads(sys.argv[1])
pkg, ver = sys.argv[2], sys.argv[3]
check2 = sys.argv[4]
for u in d[\"urls\"]:
    if u[\"packagetype\"] in (\"bdist_wheel\",):
        fn = u[\"filename\"]
        want = u[\"digests\"][\"sha256\"]
        wantsize = u[\"size\"]
        local = os.path.join(check2, fn)
        if os.path.isfile(local):
            got = hashlib.sha256(open(local,\"rb\").read()).hexdigest()
            gotsize = os.path.getsize(local)
            print(pkg, ver, fn, \"sha_match=\"+str(got==want), \"size_match=\"+str(gotsize==wantsize), \"pypi_size=\"+str(wantsize))
        else:
            print(pkg, ver, fn, \"LOCAL_MISSING\")
" "$json" "$pkg" "$ver" "$CHECK2"
done


            actualTheme = theme;
          }
          window.document.documentElement.dataset.theme = actualTheme;
        }

        // ライトテーマ固定ページ（forceLightThemeを指定しているページ）のパス一覧。
        // 直接アクセス時にダークテーマが一瞬表示されるのを防ぐため、ここでもライトテーマを適用する
        const FORCE_LIGHT_THEME_PATHS = ['/biz-lp'];
        function isForceLightThemePath() {
          return FORCE_LIGHT_THEME_PATHS.includes(window.location.pathname.replace(/\/$/, ''));
        }

        const storedTheme = localStorage.getItem('theme');
        const theme = storedTheme || 'system';
        applyTheme(isForceLightThemePath() ? 'light' : theme);

        // システムテーマの変更を監視
        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
            if (isForceLightThemePath()) return;
            const currentTheme = localStorage.getItem('theme') || 'system';
            if (currentTheme === 'system') {
              applyTheme('system');
            }
          });
        }</script><script nonce="C/7KsjGjGKoJR9GXDq9rmEPD5Ajyj2xVzj980NUyXks=">var newDataLayer = {};


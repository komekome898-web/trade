  const cxPicker=document.getElementById('cxPicker');
  const cxBody=document.getElementById('cxBody');
  const cxFn=document.getElementById('cxFn');
  cxPicker.innerHTML=ARCHE.map((a,i)=>`
    <button class="cx-chip${i===0?' active':''}" data-i="${i}">
      <span class="ci"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${a.icon}</svg></span>
      <span class="cv"><span class="cl">${a.label}</span><span class="cs">${a.short}</span></span>
    </button>`).join('');
  function renderArche(i){
    const a=ARCHE[i];
    cxFn.textContent=a.id+'.algo';
    cxBody.innerHTML=`
      <div class="cx-sentence">${a.sentence}</div>
      <div class="cx-arrow"><span class="l"></span><span>AI-built algo</span><span class="l r"></span></div>
      <div class="cx-spec">${a.spec.map(r=>`<div class="k">${r[0]}</div><div class="vv">${r[1]}</div>`).join('')}</div>
      <div class="cx-tags">${a.tags.map(t=>`<span class="cx-tag">${t}</span>`).join('')}</div>
      <div class="cx-metrics">${a.metrics.map(m=>`<div class="m"><div class="mv"${m[0][0]==='+'?' style="color:var(--green)"':(m[0][0]==='-'?' style="color:var(--red)"':'')}>${m[0]}</div><div class="ml">${m[1]}</div></div>`).join('')}</div>`;
    cxBody.classList.remove('cx-anim'); void cxBody.offsetWidth; cxBody.classList.add('cx-anim');
  }
  cxPicker.querySelectorAll('.cx-chip').forEach(btn=>{
    btn.addEventListener('click',()=>{
      cxPicker.querySelectorAll('.cx-chip').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      renderArche(+btn.dataset.i);
    });
  });
  renderArche(0);

  /* ── risk sizing panel ── */
  const entryP=100, exitP=96, riskPerUnit=Math.abs(entryP-exitP);
  const RB=document.getElementById('rBal'), RL=document.getElementById('rLev'), RR=document.getElementById('rRisk');
  const segLev=document.getElementById('segLev'), segRisk=document.getElementById('segRisk');
  const levRow=document.getElementById('levRow'), riskRow=document.getElementById('riskRow');
  const f=n=>n.toLocaleString('en-US');
  let rmode='lev';
  function calcRisk(){
    if(!RB) return;
    const bal=+RB.value;
    document.getElementById('rBalV').textContent='$'+f(bal);
    let units,notional,effLev;
    if(rmode==='lev'){
      const L=+RL.value; document.getElementById('rLevV').textContent=L+'×';
      notional=bal*L; units=notional/entryP; effLev=L;
    } else {
      const rp=+RR.value; document.getElementById('rRiskV').textContent=rp+'%';
      const riskD=bal*rp/100; units=riskD/riskPerUnit; notional=units*entryP; effLev=notional/bal;
    }
    document.getElementById('volV').textContent=f(Math.round(units));
    document.getElementById('volSub').innerHTML=`≈ $${f(Math.round(notional))} notional · ${effLev.toFixed(1)}× effective`;
  }
  function setMode(m){
    rmode=m;
    segLev.classList.toggle('active',m==='lev');
    segRisk.classList.toggle('active',m==='risk');
    levRow.style.display=m==='lev'?'':'none';
    riskRow.style.display=m==='risk'?'':'none';
    calcRisk();
  }
  if(RB){
    [RB,RL,RR].forEach(el=>el&&el.addEventListener('input',calcRisk));
    segLev.addEventListener('click',()=>setMode('lev'));
    segRisk.addEventListener('click',()=>setMode('risk'));
    calcRisk();
  }
  const cxAcc=document.getElementById('cxAccordion');
  if(cxAcc){
    cxAcc.innerHTML=ARCHE.map((a,i)=>`
      <details class="cx-acc-item"${i===0?' open':''}>
        <summary>
          <span class="ci"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${a.icon}</svg></span>
          <span class="cl">${a.label}<span class="cs">${a.short}</span></span>
          <span class="ico"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
        </summary>
        <div class="body">
          <div class="cx-sentence">${a.sentence}</div>
          <div class="cx-spec">${a.spec.map(r=>`<div class="k">${r[0]}</div><div class="vv">${r[1]}</div>`).join('')}</div>
          <div class="cx-tags">${a.tags.map(t=>`<span class="cx-tag">${t}</span>`).join('')}</div>
          <div class="cx-metrics">${a.metrics.map(m=>`<div class="m"><div class="mv"${m[0][0]==='+'?' style="color:var(--green)"':(m[0][0]==='-'?' style="color:var(--red)"':'')}>${m[0]}</div><div class="ml">${m[1]}</div></div>`).join('')}</div>
        </div>
      </details>`).join('');
    cxAcc.querySelectorAll('.cx-acc-item').forEach(item=>{
      item.addEventListener('toggle', ()=>{
        if(item.open){
          cxAcc.querySelectorAll('.cx-acc-item').forEach(other=>{
            if(other!==item) other.open=false;
          });
        }
      });
    });
  }
</script>				</div>

<!-- HOW IT WORKS -->
<section id="how" class="section" style="background:rgba(255,255,255,0.01);border-top:1px solid var(--border);border-bottom:1px solid var(--border)">
  <div class="container">
    <div class="section-head" data-reveal>
      <div class="eyebrow"><span class="dot"></span> How it works</div>
      <h2 style="margin-top:18px">From one sentence to a <span class="accent">live algo</span>.</h2>
      <p>Four steps from a sentence to live execution.</p>
    </div>
    <div class="pipe">
      <div class="pipe-line"></div>
      <div class="pipe-step" data-reveal data-delay="1">
        <div class="pipe-num">01</div>
        <h4>Describe</h4>
        <p>Write your edge in plain language — order blocks, wave counts, springs, squeezes, any indicator, plus calendars and cross-asset signals. Any market. No code.</p>

<style id="wp-custom-css">
/* Algorier — Slippage article styles (v2: neutral, matches site theme).
   Paste into Appearance > Customize > Additional CSS, then Publish.
   Scoped under .algr-slip. No custom fonts — inherits your theme. */

.algr-slip{max-width:840px;margin:0 auto}
.algr-slip *{box-sizing:border-box}

/* spacing only — headings & text inherit the site theme */
.algr-slip h2{margin:48px 0 10px}
.algr-slip h3{margin:26px 0 4px}
.algr-slip p{margin:14px 0}
.algr-slip ul{margin:14px 0}
.algr-slip ul li{margin:4px 0}

/* table of contents */
.algr-slip .toc{border:1px solid #e5e7eb;border-radius:12px;padding:20px 24px;margin:24px 0;background:#fafafa}
.algr-slip .toc .toc-h{font-weight:700;font-size:13px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280;margin-bottom:12px}
.algr-slip .toc ol{margin:0;padding-left:1.2em;columns:2;column-gap:36px}
.algr-slip .toc li{margin:0 0 7px;break-inside:avoid}
@media(max-width:560px){.algr-slip .toc ol{columns:1}}

/* price chips */
.algr-slip .pricerow{display:flex;flex-wrap:wrap;gap:12px;margin:20px 0}
.algr-slip .pricechip{flex:1 1 140px;border:1px solid #e5e7eb;border-radius:10px;padding:14px 16px;background:#fff}
.algr-slip .pricechip .lab{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280}
.algr-slip .pricechip .val{font-size:26px;font-weight:700;margin-top:4px}
.algr-slip .pricechip.exp .val{color:#2F7D6E}
.algr-slip .pricechip.exe .val{color:#334155}
.algr-slip .pricechip.slip{background:#F7ECE8;border-color:#E6C9BF}
.algr-slip .pricechip.slip .val{color:#C0573F}

/* callouts */
.algr-slip .callout{border:1px solid #e5e7eb;border-left:4px solid #2F7D6E;border-radius:10px;padding:18px 22px;margin:22px 0;background:#fafafa}
.algr-slip .callout.warn{border-left-color:#C0573F}
.algr-slip .callout .k{font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:#6b7280;margin-bottom:4px}
.algr-slip .callout .big{font-size:26px;font-weight:700;color:#1F2937;line-height:1.15;margin:2px 0}
.algr-slip .callout p{margin:6px 0 0}

/* two-column compare */
.algr-slip .compare{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:22px 0}
@media(max-width:600px){.algr-slip .compare{grid-template-columns:1fr}}
.algr-slip .compare .callout{margin:0}

/* tables */
.algr-slip table{width:100%;border-collapse:collapse;margin:8px 0;font-size:15px}
.algr-slip caption{caption-side:top;text-align:left;font-weight:700;font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#6b7280;padding:0 0 8px}
.algr-slip th,.algr-slip td{text-align:left;padding:10px 14px;border:1px solid #e5e7eb}
.algr-slip thead th{background:#f3f4f6}
.algr-slip .risk-hi{color:#C0573F;font-weight:600}

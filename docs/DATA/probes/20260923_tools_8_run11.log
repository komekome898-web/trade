/* diagram container */
.algr-slip .diagram{border:1px solid #e5e7eb;border-radius:12px;margin:24px 0;overflow:hidden;background:#fff}
.algr-slip .diagram-head{padding:12px 18px;border-bottom:1px solid #e5e7eb;display:flex;gap:10px;align-items:center}
.algr-slip .diagram-head .tag{font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#fff;background:#2F7D6E;padding:3px 8px;border-radius:5px}
.algr-slip .diagram-head .title{font-weight:600;font-size:15px}
.algr-slip .diagram-body{padding:22px}
.algr-slip .diagram svg{width:100%;height:auto;display:block}

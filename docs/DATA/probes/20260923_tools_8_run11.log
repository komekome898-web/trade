    <script>
    (function () {
      var params = new URLSearchParams(window.location.search);

      var gclid = params.get("gclid") || params.get("gbraid") || params.get("wbraid");
      var medium = (params.get("utm_medium") || "").toLowerCase();

      var isAds = !!(gclid || medium === "cpc");

      // detect slug
      var path = window.location.pathname.replace(/^\/|\/$/g, "");
      var forcedCampaign = (path === "trade-with-algorithms" || 
							path === "marketplace" || 
							path === "trading-bot-marketplace") ? "publish_and_deploy" : null;

      document.querySelectorAll('[data-cta="true"], .cta-button, a.cta').forEach(function (el) {
        try {
          var url = new URL(el.href);

          // فقط اگر Ads بود، source/medium ست کن
          if (isAds) {
            url.searchParams.set("utm_source", "google");
            url.searchParams.set("utm_medium", "cpc");
          }

          // campaign فقط اگر:
          // 1. اسلاگ ما بود
          // 2. از قبل campaign نداشت
          if (forcedCampaign && !url.searchParams.get("utm_campaign")) {
            url.searchParams.set("utm_campaign", forcedCampaign);
          }

          // gclid رو هم پاس بده
          if (gclid) {
            url.searchParams.set("gclid", gclid);
          }

          el.href = url.toString();
        } catch (_) {}
      });
    })();
    </script>

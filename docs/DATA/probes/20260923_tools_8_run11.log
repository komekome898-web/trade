<script>
  /* ── progress + nav + parallax ── */
  const prog=document.getElementById('progress'), nav=document.getElementById('nav');
  function onScroll(){
    const st=window.scrollY, h=document.documentElement.scrollHeight-window.innerHeight;
    prog.style.width=(st/h*100)+'%';
    if(nav) nav.classList.toggle('solid', st>40);
    const ga=document.getElementById('glowA'), gb=document.getElementById('glowB'), hg=document.getElementById('heroGrid');
    if(st<window.innerHeight){
      if(ga) ga.style.transform=`translateY(${st*0.3}px)`;
      if(gb) gb.style.transform=`translateY(${-st*0.2}px)`;
      if(hg) hg.style.transform=`translateY(${st*0.05}px)`;
    }
    const eo=document.getElementById('earnOrb');
    if(eo){const r=eo.getBoundingClientRect();eo.style.transform=`translateX(-50%) translateY(${(window.innerHeight-r.top)*0.05}px)`;}
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();
  document.body.classList.add('ready');
  window.scrollTo(0,0);

  /* ── reveal observer ── */
  const ro=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');ro.unobserve(e.target);}});},{threshold:0.15});
  document.querySelectorAll('[data-reveal]').forEach(el=>ro.observe(el));

  /* ── scene nav active ── */
  const navDots=[...document.querySelectorAll('.scene-nav a')];
  const navSecs=navDots.map(a=>document.querySelector(a.getAttribute('href')));
  const sobs=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){const i=navSecs.indexOf(e.target);navDots.forEach((d,j)=>d.classList.toggle('active',j===i));}});},{threshold:0.4});
  navSecs.forEach(s=>{if(s)sobs.observe(s);});

  /* ── marquee: strategy ingredients ── */
  const ING=['Moving averages & crossovers','RSI · MACD · Bollinger','Elliott wave counts','Fibonacci retracements & extensions','Smart money concepts','Order blocks & fair value gaps','Liquidity sweeps · BOS · CHoCH','Wyckoff accumulation & springs','Harmonic patterns','Supply & demand zones','Ichimoku · ADX · Keltner','Volatility squeezes','Divergences (regular & hidden)','Volume expansion','Multi-timeframe confluence','Economic calendar · CPI · NFP · FOMC','Earnings calendar & surprise','Intermarket lead-lag','Statistical z-score spreads','Scaling, pyramiding & trailing stops'];
  const mq=document.getElementById('marquee');
  const dot=`<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
  const tk=t=>`<div class="tk">${dot}<span>${t}</span></div>`;
  if(mq) mq.innerHTML=[...ING,...ING].map(tk).join('');

  /* ── HERO compiler typewriter ── */
  const HERO_EX=[
    {
      text:'Wait for a sweep of the previous day low, then a bullish change of character on the 15m. Enter on the retest of the 1H demand order block, stop below the sweep, target the opposing liquidity.',
      spec:[['liquidity','sweep(prevDayLow) &amp;&amp; wickRejection'],['structure','<span class="kw">on</span> CHoCH(<span class="st">15m</span>) → bias = <span class="st">LONG</span>'],['entry','limit <span class="kw">at</span> orderBlock(<span class="st">1h</span>).retest · <span class="kw">unfilled</span> FVG ok'],['stop','below the sweep low · target = opposing liquidity pool'],['markets','BTC · ETH · Index futures']],
      tags:['Liquidity sweep','CHoCH','Order block','Fair value gap'],
      metrics:[['+164%','Return'],['57%','Win'],['2.9','R:R'],['-11%','Max DD']]
    },
    {
      text:'Buy the wave-4 pullback into the 38.2 to 50 percent retracement of wave 3 while the impulse structure holds and RSI stays above 40. Target the 1.618 extension for wave 5.',
      spec:[['structure','impulse(<span class="st">1-2-3</span>) valid · wave4 <span class="kw">does not</span> overlap wave1'],['entry','fib.retrace(wave3) ∈ [<span class="st">0.382</span>, <span class="st">0.50</span>] &amp;&amp; RSI(<span class="st">14</span>) &gt; <span class="st">40</span>'],['target','fib.extension(wave3) = <span class="st">1.618</span> → wave5'],['invalidate','close &lt; wave1.high'],['markets','Equities · FX · Crypto']],
      tags:['Elliott wave','Fibonacci retrace','1.618 extension','Structural invalidation'],
      metrics:[['+128%','Return'],['54%','Win'],['3.1','R:R'],['-14%','Max DD']]
    },
    {
      text:'After an earnings beat, buy the stock only if it reclaims its 50-day on a Bollinger squeeze break and the last CPI came in soft. Hold five sessions.',
      spec:[['trigger','earnings.surprise &gt; <span class="st">0</span> (top quartile)'],['technical','bbSqueeze.release &amp;&amp; close &gt; SMA(<span class="st">50</span>)'],['macro','cpi.actual &lt; cpi.consensus (last release)'],['exit','time-stop <span class="st">T+5</span> <span class="kw">or</span> stop <span class="st">1.5×ATR</span>'],['markets','US Equities']],
      tags:['Earnings calendar','Squeeze break','CPI filter','Post-event drift'],
      metrics:[['+97%','Return'],['66%','Win'],['2.4','PF'],['-8%','Max DD']]
    },
    {
      text:'Trade the gold-silver spread back to its mean whenever it stretches two standard deviations, but stand aside on FOMC days.',
      spec:[['signal','zScore(spread(XAU,XAG), <span class="st">60d</span>) &gt; |<span class="st">2</span>|'],['entry','fade the spread · long the laggard, short the leader'],['blackout','<span class="kw">no</span> new entries on FOMC / CPI days'],['exit','z → <span class="st">0</span> <span class="kw">or</span> time-stop <span class="st">15d</span>'],['markets','Metals']],
      tags:['Statistical arbitrage','Z-score','Event blackout','Mean reversion'],
      metrics:[['+71%','Return'],['68%','Win'],['2.2','PF'],['-7%','Max DD']]
    }
  ];
  const typedEl=document.getElementById('typed');
  const compChip=document.getElementById('compChip');
  const compOut=document.getElementById('compOut');
  const compSpec=document.getElementById('compSpec');
  const compTags=document.getElementById('compTags');
  const compMetrics=document.getElementById('compMetrics');
  function renderHeroOut(ex){
    compSpec.innerHTML=ex.spec.map(r=>`<div class="k">${r[0]}</div><div class="vv">${r[1]}</div>`).join('');
    compTags.innerHTML=ex.tags.map(t=>`<span class="sig-tag">${t}</span>`).join('');
    compMetrics.innerHTML=ex.metrics.map(m=>`<div class="m"><div class="mv"${m[0][0]==='+'?' style="color:var(--green)"':(m[0][0]==='-'?' style="color:var(--red)"':'')}>${m[0]}</div><div class="ml">${m[1]}</div></div>`).join('');
  }
  let hi=0;
  function runHero(){
    const ex=HERO_EX[hi];
    typedEl.textContent='';
    compOut.classList.remove('show');
    compChip.innerHTML='<span class="spin"></span> awaiting input…';
    let i=0;
    const type=()=>{
      if(i<=ex.text.length){
        typedEl.textContent=ex.text.slice(0,i);
        i++;
        setTimeout(type, 18+Math.random()*30);
      } else {
        compChip.innerHTML='<span class="spin"></span> compiling…';
        setTimeout(()=>{
          compChip.innerHTML='<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> compiled';
          renderHeroOut(ex);
          compOut.classList.add('show');
          setTimeout(()=>{ hi=(hi+1)%HERO_EX.length; runHero(); }, 4200);
        }, 900);
      }
    };
    setTimeout(type, 500);
  }
  runHero();

  /* ── ANY-COMPLEXITY interactive compiler ── */
  const ARCHE=[
    {
      id:'crossover', label:'Trend Crossover', short:'Golden cross + ATR trail',
      icon:'<path d="M3 17 9 11l4 4 8-8"/><path d="M3 7 9 13l4-4 8 8"/>',
      sentence:'Go long when the 50-day crosses above the 200-day and price holds above both; exit on the reverse cross or a two-ATR trailing stop.',
      spec:[['signal','SMA(<span class="st">50</span>) crossesAbove SMA(<span class="st">200</span>)'],['filter','close &gt; SMA(<span class="st">200</span>)'],['entry','long <span class="kw">on</span> the close of the cross bar'],['exit','reverse cross <span class="kw">or</span> trail <span class="st">2×ATR(14)</span>'],['markets','Equities · FX · Crypto']],
      tags:['Moving averages','Golden cross','ATR trailing stop','Daily'],
      metrics:[['+64%','Return'],['48%','Win rate'],['1.8','Profit factor'],['-12%','Max DD']]
    },
    {
      id:'smc', label:'Smart Money Concepts', short:'Sweep → CHoCH → order block',
      icon:'<path d="M3 16h3l2-9 3 13 2.5-7H21"/><path d="M3 20h18"/>',

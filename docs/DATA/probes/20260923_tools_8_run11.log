				<div data-elementor-type="wp-page" data-elementor-id="19551" class="elementor elementor-19551" data-elementor-post-type="page">
				<div class="elementor-element elementor-element-cf2874f e-con-full e-flex e-con e-parent" data-id="cf2874f" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-a363cb7 elementor-widget elementor-widget-html" data-id="a363cb7" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
				<div class="elementor-widget-container">
					<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  :root{
    --green:#18f2a2;--bg:#040608;--card:rgba(255,255,255,0.025);
    --border:rgba(255,255,255,0.06);--text:rgba(255,255,255,0.92);
    --mute:rgba(255,255,255,0.5);--dim:rgba(255,255,255,0.3);
    --blue:#7ab6ff;--amber:#f5b85a;--red:#ff5b73;--purple:#b794f6;
  }
  body{font-family:'Inter',system-ui,sans-serif;background:var(--bg) !important;color:var(--text);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.6}

  h1,h2,h3,h4,.font-display{font-family:'Space Grotesk',sans-serif !important}
  .accent{background:linear-gradient(90deg,var(--green),#7af5c4);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .amber-accent{background:linear-gradient(90deg,var(--amber),#ffd591);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .container{max-width:1240px;margin:0 auto;padding:0 32px;position:relative;z-index:2}
  .mono{font-family:'JetBrains Mono',monospace}
  .section{padding:120px 0}
  .section-head{max-width:760px;margin:0 auto 64px;text-align:center}
  .section-head h2{font-size:clamp(30px,3.8vw,50px);font-weight:800;letter-spacing:-0.035em;line-height:1.06}
  .section-head p{font-size:16.5px;color:var(--mute);margin-top:18px;line-height:1.65}

  /* progress bar */
  .scroll-progress{position:fixed;top:0;left:0;height:3px;background:linear-gradient(90deg,var(--green),#7af5c4);z-index:200;width:0%;box-shadow:0 0 12px var(--green)}

  /* side scene dots */
  .scene-nav{position:fixed;right:26px;top:50%;transform:translateY(-50%);z-index:90;display:flex;flex-direction:column;gap:14px}
  .scene-nav a{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,0.15);transition:all .3s;position:relative}
  .scene-nav a.active{background:var(--green);box-shadow:0 0 10px var(--green);transform:scale(1.3)}
  .scene-nav a::after{content:attr(data-label);position:absolute;right:20px;top:50%;transform:translateY(-50%);font-size:11px;font-weight:600;color:var(--mute);white-space:nowrap;opacity:0;transition:opacity .2s;pointer-events:none}
  .scene-nav a:hover::after{opacity:1}

  .btn{display:inline-flex;align-items:center;gap:9px;padding:11px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;font-family:inherit;text-decoration:none;transition:all .25s;border:none;white-space:nowrap}
  .btn-primary{background:linear-gradient(180deg,var(--green),#14d68f);color:#04130b !important;box-shadow:0 10px 30px rgba(24,242,162,0.4),inset 0 1px 0 rgba(255,255,255,0.25) !important;position:relative;overflow:hidden}
  .btn-primary::before{content:'';position:absolute;inset:0;background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,0.3) 50%,transparent 70%);transform:translateX(-120%);transition:transform .6s}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(24,242,162,0.55)}
  .btn-primary:hover::before{transform:translateX(120%)}
  .btn-ghost{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.12);color:#fff}
  .btn-ghost:hover{background:rgba(255,255,255,0.09)}
  .btn-lg{padding:16px 30px;font-size:15px;border-radius:12px}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:700;letter-spacing:0.18em;text-transform:uppercase;color:var(--green);padding:6px 14px;background:rgba(24,242,162,0.08);border:1px solid rgba(24,242,162,0.28);border-radius:999px;white-space:nowrap}
  .eyebrow .dot{width:5px;height:5px;border-radius:5px;background:var(--green);box-shadow:0 0 6px var(--green);animation:pd 1.8s infinite}
  @keyframes pd{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.8)}}

  /* ── reveal system ── */
  [data-reveal]{opacity:0;transform:translateY(40px);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 1s cubic-bezier(.16,1,.3,1)}
  [data-reveal].in{opacity:1;transform:translateY(0)}
  [data-reveal="left"]{transform:translateX(-50px)}
  [data-reveal="left"].in{transform:translateX(0)}
  [data-reveal="right"]{transform:translateX(50px)}
  [data-reveal="right"].in{transform:translateX(0)}
  [data-reveal="scale"]{transform:scale(0.92)}
  [data-reveal="scale"].in{transform:scale(1)}
  [data-delay="1"]{transition-delay:.08s}[data-delay="2"]{transition-delay:.16s}
  [data-delay="3"]{transition-delay:.24s}[data-delay="4"]{transition-delay:.32s}
  [data-delay="5"]{transition-delay:.4s}[data-delay="6"]{transition-delay:.48s}

  /* hero entrance */
  .hero h1 .ln{display:block;overflow:hidden}
  .hero h1 .ln > span{display:block;transform:translateY(108%) skewY(7deg);filter:blur(8px);opacity:0}
  body.ready .hero h1 .ln > span{animation:lineUp 1.05s cubic-bezier(.16,1,.3,1) both}
  body.ready .hero h1 .ln:nth-child(1) > span{animation-delay:.15s}
  body.ready .hero h1 .ln:nth-child(2) > span{animation-delay:.3s}
  @keyframes lineUp{to{transform:translateY(0) skewY(0);filter:blur(0);opacity:1}}
  .cine-up{opacity:0;transform:translateY(26px);filter:blur(6px)}
  body.ready .cine-up{animation:cineUp 1s cubic-bezier(.16,1,.3,1) both}
  body.ready .cine-up.d1{animation-delay:.5s}
  body.ready .cine-up.d2{animation-delay:.62s}
  body.ready .cine-up.d3{animation-delay:.74s}
  body.ready .cine-up.d4{animation-delay:.86s}
  @keyframes cineUp{to{opacity:1;transform:translateY(0);filter:blur(0)}}
  .compiler-rise{opacity:0;transform:translateY(40px) scale(.97)}
  body.ready .compiler-rise{animation:compRise 1.2s cubic-bezier(.16,1,.3,1) .35s both}
  @keyframes compRise{to{opacity:1;transform:translateY(0) scale(1)}}

  /* ════ HERO ════ */
  .hero{position:relative;min-height:100vh;display:flex;align-items:center;overflow:hidden;padding:120px 0 64px}
  .hero-bg{position:absolute;inset:0;z-index:0}
  .hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 75% 65% at 60% 40%,#000 10%,transparent 80%);-webkit-mask-image:radial-gradient(ellipse 75% 65% at 60% 40%,#000 10%,transparent 80%)}
  .glow-a{position:absolute;width:900px;height:700px;border-radius:50%;top:-220px;left:-180px;background:radial-gradient(circle,rgba(24,242,162,0.18),transparent 60%)}
  .glow-b{position:absolute;width:700px;height:600px;border-radius:50%;bottom:-200px;right:-140px;background:radial-gradient(circle,rgba(122,182,255,0.08),transparent 60%)}
  .hero-inner{display:grid;grid-template-columns:1fr 1.02fr;gap:56px;align-items:center;width:100%}
  .hero h1{font-size:clamp(38px,5.1vw,68px);font-weight:800;letter-spacing:-0.04em;line-height:1.08}
  .hero .sub{font-size:17.5px;color:var(--mute);max-width:520px;margin-top:26px;line-height:1.66}
  .hero-cta{display:flex;gap:13px;margin-top:36px;flex-wrap:wrap}
  .hero-stats{display:flex;gap:34px;margin-top:46px;padding-top:30px;border-top:1px solid var(--border)}
  .hero-stats .v{font-family:'Space Grotesk';font-size:26px;font-weight:800;letter-spacing:-0.02em;display:flex;align-items:center;gap:7px}
  .hero-stats .v svg{color:var(--green)}
  .hero-stats .l{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:0.07em;margin-top:5px;font-weight:600;max-width:130px;line-height:1.4}

  /* ════ HERO COMPILER (signature visual) ════ */
  .compiler{position:relative;border-radius:20px;border:1px solid var(--border);background:rgba(8,11,14,0.72);box-shadow:0 40px 100px rgba(0,0,0,0.55);overflow:hidden;backdrop-filter:blur(8px)}
  .compiler::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 70% 0%,rgba(24,242,162,0.1),transparent 55%);pointer-events:none}
  .comp-head{display:flex;align-items:center;gap:8px;padding:14px 18px;border-bottom:1px solid var(--border);position:relative;z-index:2}
  .comp-head .d{width:11px;height:11px;border-radius:50%}
  .comp-head .ttl{margin-left:8px;font-family:'JetBrains Mono';font-size:12px;color:var(--mute)}
  .comp-head .badge{margin-left:auto;font-family:'JetBrains Mono';font-size:10.5px;font-weight:700;letter-spacing:0.08em;color:var(--green);padding:4px 10px;background:rgba(24,242,162,0.1);border:1px solid rgba(24,242,162,0.28);border-radius:6px;display:inline-flex;align-items:center;gap:6px}
  .comp-head .badge .blip{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:pd 1.6s infinite}
  /* input row */
  .comp-input{padding:22px 22px 18px;position:relative;z-index:2}
  .comp-input .lbl{font-size:10.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--dim);margin-bottom:11px;display:flex;align-items:center;gap:8px}
  .comp-input .lbl::before{content:'';width:16px;height:1px;background:var(--green)}
  .comp-prompt{font-family:'JetBrains Mono';font-size:15px;line-height:1.7;color:#fff;min-height:78px}
  .comp-prompt .typed{color:#fff}
  .comp-prompt .tcaret{display:inline-block;width:8px;height:17px;background:var(--green);vertical-align:text-bottom;margin-left:2px;animation:bl 1s steps(1) infinite}
  @keyframes bl{50%{opacity:0}}
  .comp-divider{display:flex;align-items:center;gap:12px;padding:4px 22px;position:relative;z-index:2}
  .comp-divider .line{flex:1;height:1px;background:var(--border)}
  .comp-divider .chip{font-family:'JetBrains Mono';font-size:11px;font-weight:700;color:var(--green);display:inline-flex;align-items:center;gap:7px}
  .comp-divider .chip .spin{width:13px;height:13px;border:1.6px solid rgba(24,242,162,0.3);border-top-color:var(--green);border-radius:50%;animation:spin 0.8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  /* compiled output */
  .comp-out{padding:18px 22px 22px;position:relative;z-index:2;min-height:188px;opacity:0;transform:translateY(8px);transition:opacity .5s,transform .5s}
  .comp-out.show{opacity:1;transform:translateY(0)}
  .spec{display:grid;grid-template-columns:auto 1fr;gap:9px 16px;font-family:'JetBrains Mono';font-size:12.5px;margin-bottom:16px}
  .spec .k{color:var(--dim);font-weight:600}
  .spec .vv{color:var(--text)}
  .spec .vv .kw{color:var(--blue)}
  .spec .vv .st{color:var(--amber)}
  .sig-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
  .sig-tag{font-family:'JetBrains Mono';font-size:10.5px;font-weight:600;color:var(--green);padding:4px 9px;border:1px solid rgba(24,242,162,0.28);background:rgba(24,242,162,0.06);border-radius:6px}
  .comp-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .comp-metrics .m{padding:11px 8px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:9px;text-align:center}
  .comp-metrics .m .mv{font-family:'Space Grotesk';font-size:17px;font-weight:800}
  .comp-metrics .m .ml{font-size:8.5px;color:var(--dim);text-transform:uppercase;letter-spacing:0.05em;margin-top:3px;font-weight:700}
  .comp-note{padding:0 22px 18px;font-family:'JetBrains Mono';font-size:11px;color:var(--dim);position:relative;z-index:2;line-height:1.5}

  /* ════ marquee ════ */
  .marquee-wrap{padding:24px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:rgba(255,255,255,0.012);overflow:hidden;position:relative;z-index:2}
  .marquee-wrap::before,.marquee-wrap::after{content:'';position:absolute;top:0;bottom:0;width:120px;z-index:3;pointer-events:none}
  .marquee-wrap::before{left:0;background:linear-gradient(90deg,var(--bg),transparent)}
  .marquee-wrap::after{right:0;background:linear-gradient(270deg,var(--bg),transparent)}
  .marquee{display:flex;width:max-content;animation:mq 48s linear infinite}
  @keyframes mq{to{transform:translateX(-50%)}}
  .tk{display:inline-flex;align-items:center;gap:11px;padding:0 28px;border-right:1px solid var(--border);font-family:'JetBrains Mono';font-size:13px;white-space:nowrap;color:var(--mute)}
  .tk svg{color:var(--green);flex-shrink:0}

  /* ════ ANY-COMPLEXITY interactive compiler ════ */
  .cx{position:relative;overflow:hidden}
  .cx-glow{position:absolute;width:1000px;height:700px;border-radius:50%;left:50%;top:-200px;transform:translateX(-50%);background:radial-gradient(circle,rgba(24,242,162,0.08),transparent 62%);z-index:0}
  .cx-stage{display:grid;grid-template-columns:0.82fr 1.18fr;gap:32px;align-items:start;max-width:1120px;margin:0 auto}
  .cx-picker{display:flex;flex-direction:column;gap:10px}
  .cx-chip{display:flex;align-items:center;gap:14px;padding:16px 18px !important;background:var(--card) !important;border:1px solid var(--border) !important;border-radius:14px !important;cursor:pointer;text-align:left;font-family:inherit;color:var(--text) !important;transition:all .22s;width:100%}
  .cx-chip:hover{border-color:rgba(255,255,255,0.16);transform:translateX(3px)}
  .cx-chip.active{border-color:rgba(24,242,162,0.5);background:rgba(24,242,162,0.05);box-shadow:0 0 0 1px rgba(24,242,162,0.2),0 12px 30px rgba(0,0,0,0.3)}
  .cx-chip .ci{width:40px;height:40px;border-radius:11px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--mute);transition:all .22s}
  .cx-chip.active .ci{background:linear-gradient(135deg,rgba(24,242,162,0.18),transparent);border-color:rgba(24,242,162,0.35);color:var(--green)}
  .cx-chip .cl{font-size:14.5px;font-weight:700;letter-spacing:-0.01em}
  .cx-chip .cs{font-size:11.5px;color:var(--dim);margin-top:2px}
  /* output card */
  .cx-card{position:sticky;top:96px;border-radius:20px;border:1px solid var(--border);background:rgba(8,11,14,0.7);box-shadow:0 30px 80px rgba(0,0,0,0.5);overflow:hidden;min-height:430px}
  .cx-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 75% 5%,rgba(24,242,162,0.09),transparent 55%);pointer-events:none}
  .cx-card-head{display:flex;align-items:center;gap:8px;padding:15px 20px;border-bottom:1px solid var(--border);position:relative;z-index:2}
  .cx-card-head .d{width:10px;height:10px;border-radius:50%}
  .cx-card-head .fn{margin-left:6px;font-family:'JetBrains Mono';font-size:12px;color:var(--mute)}
  .cx-card-head .ok{margin-left:auto;font-family:'JetBrains Mono';font-size:10.5px;font-weight:700;letter-spacing:0.06em;color:var(--green);display:inline-flex;align-items:center;gap:6px}
  .cx-body{padding:24px 24px 26px;position:relative;z-index:2}
  .cx-sentence{font-family:'JetBrains Mono';font-size:14.5px;line-height:1.72;color:var(--amber);padding:16px 18px;background:rgba(245,184,90,0.05);border:1px solid rgba(245,184,90,0.18);border-radius:12px;margin-bottom:22px}
  .cx-sentence::before{content:'“'}
  .cx-sentence::after{content:'”'}
  .cx-arrow{display:flex;align-items:center;gap:13px;margin:0 0 20px;font-family:'JetBrains Mono';font-size:11px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--dim)}
  .cx-arrow .l{flex:1;height:1px;background:linear-gradient(90deg,var(--border),transparent)}
  .cx-arrow .l.r{background:linear-gradient(270deg,var(--border),transparent)}
  .cx-spec{display:grid;grid-template-columns:auto 1fr;gap:11px 18px;font-family:'JetBrains Mono';font-size:13px;margin-bottom:20px}
  .cx-spec .k{color:var(--dim);font-weight:600;white-space:nowrap}
  .cx-spec .vv .kw{color:var(--blue)}
  .cx-spec .vv .st{color:var(--green)}
  .cx-tags{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:22px}
  .cx-tag{font-family:'JetBrains Mono';font-size:11px;font-weight:600;color:var(--green);padding:5px 11px;border:1px solid rgba(24,242,162,0.28);background:rgba(24,242,162,0.06);border-radius:7px}
  .cx-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .cx-metrics .m{padding:13px 10px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:11px;text-align:center}
  .cx-metrics .m .mv{font-family:'Space Grotesk';font-size:20px;font-weight:800}
  .cx-metrics .m .ml{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:0.05em;margin-top:3px;font-weight:700}
  .cx-anim{animation:cxFade .45s cubic-bezier(.16,1,.3,1)}
  .cv{display: flex;gap: 5px;}
  @keyframes cxFade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}

  /* ════ PIPELINE stepper ════ */
  .pipe{display:grid;grid-template-columns:repeat(4,1fr);gap:0;max-width:1120px;margin:0 auto;position:relative}
  .pipe-step{position:relative;padding:0 26px}
  .pipe-step:not(:last-child)::after{content:'';position:absolute;top:30px;right:-1px;width:2px;height:calc(100% - 30px);background:none}
  .pipe-line{position:absolute;top:30px;left:8%;right:8%;height:2px;background:linear-gradient(90deg,rgba(24,242,162,0.5),rgba(24,242,162,0.2) 60%,rgba(245,184,90,0.4));z-index:0}
  .pipe-num{position:relative;width:60px;height:60px;border-radius:16px;background:linear-gradient(180deg,#0d1714,#080d0b);border:1px solid rgba(24,242,162,0.4);display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk';font-weight:800;font-size:20px;color:var(--green);box-shadow:0 0 0 7px var(--bg),0 0 26px rgba(24,242,162,0.25);z-index:2;margin-bottom:26px}
  .pipe-step h4{font-size:18px;font-weight:800;letter-spacing:-0.02em;margin-bottom:10px}
  .pipe-step p{font-size:13.5px;color:var(--mute);line-height:1.6}
  .pipe-step .pico{margin-top:14px;color:var(--green);opacity:.5}

  /* ════ QUALITY gate ════ */
  .gate-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:8px}
  .gate{padding:26px 24px;background:var(--card);border:1px solid var(--border);border-radius:18px;transition:all .25s}
  .gate:hover{transform:translateY(-3px);border-color:rgba(24,242,162,0.25)}
  .gate .ic{width:46px;height:46px;border-radius:12px;background:linear-gradient(135deg,rgba(24,242,162,0.15),transparent);border:1px solid rgba(24,242,162,0.25);color:var(--green);display:flex;align-items:center;justify-content:center;margin-bottom:18px}
  .gate h5{font-size:16px;font-weight:700;margin-bottom:8px}
  .gate p{font-size:13px;color:var(--mute);line-height:1.58}

  /* ════ EARN ════ */
  .earn{position:relative;padding:140px 0;overflow:hidden;border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
  .earn-bg{position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,242,162,0.05),transparent 40%,transparent 60%,rgba(245,184,90,0.04));z-index:0}
  .earn-orb{position:absolute;width:1000px;height:700px;border-radius:50%;left:50%;top:-100px;transform:translateX(-50%);background:radial-gradient(circle,rgba(24,242,162,0.14),transparent 60%);z-index:0}
  .earn-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .calc{padding:34px;background:rgba(8,12,15,0.85);border:1px solid rgba(24,242,162,0.25);border-radius:24px;backdrop-filter:blur(12px);box-shadow:0 32px 80px rgba(0,0,0,0.5)}
  .calc .row{margin-bottom:22px}
  .calc .lab{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .calc .lab .l{font-size:12.5px;color:var(--mute);font-weight:600}
  .calc .lab .v{font-family:'JetBrains Mono';font-size:18px;font-weight:800}
  input[type=range]{-webkit-appearance:none;width:100%;height:6px;background:rgba(255,255,255,0.08);border-radius:6px;outline:none}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:linear-gradient(180deg,var(--green),#14d68f);cursor:pointer;border:3px solid var(--bg);box-shadow:0 4px 14px rgba(24,242,162,0.5)}
  input[type=range]::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--green);cursor:pointer;border:3px solid var(--bg)}
  .calc-out{padding:24px;background:linear-gradient(135deg,rgba(24,242,162,0.12),rgba(24,242,162,0.04));border:1px solid rgba(24,242,162,0.35);border-radius:16px;margin-top:14px;text-align:center;position:relative;overflow:hidden}
  .calc-out .l{font-size:11.5px;color:var(--green);font-weight:800;letter-spacing:0.16em;text-transform:uppercase;margin-bottom:6px}
  .calc-out .v{font-family:'Space Grotesk';font-size:58px;font-weight:900;letter-spacing:-0.04em;line-height:1;color:#fff}
  .calc-out .v .s{font-size:24px;color:var(--green);vertical-align:top;margin-left:4px}
  .calc-out .sub{font-size:12.5px;color:var(--mute);margin-top:8px}
  .ef{display:flex;align-items:flex-start;gap:14px;margin-bottom:22px}
  .ef-ic{width:42px;height:42px;border-radius:11px;background:linear-gradient(135deg,var(--green),#0fb672);color:#04130b;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 6px 20px rgba(24,242,162,0.4)}
  .ef .t{font-size:16px;font-weight:700;margin-bottom:5px}
  .ef .d{font-size:13.5px;color:var(--mute);line-height:1.55}
  /* risk sizing panel */
  .risk-title{font-size:12.5px;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:var(--green);margin-bottom:18px}
  .levels{display:flex;gap:10px;margin-bottom:10px}
  .lvl{flex:1;padding:13px 15px;background:rgba(255,255,255,0.03);border:1px solid var(--border);border-radius:12px}
  .lvl .k{font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:0.08em;font-weight:700;display:flex;align-items:center;gap:6px}
  .lvl .k .pt{width:6px;height:6px;border-radius:50%}
  .lvl.entry .k .pt{background:var(--green)}.lvl.exit .k .pt{background:var(--red)}
  .lvl .v{font-family:'JetBrains Mono';font-size:19px;font-weight:800;margin-top:6px}
  .lvl.entry .v{color:var(--green)}.lvl.exit .v{color:var(--red)}
  .lvl-note{font-family:'JetBrains Mono';font-size:11px;color:var(--dim);margin-bottom:20px}
  .seg-toggle{display:flex;gap:6px;padding:5px;background:rgba(255,255,255,0.04);border:1px solid var(--border);border-radius:12px;margin-bottom:22px}
  .seg-toggle button{flex:1;padding:11px;border:none;background:transparent;color:var(--mute);font-family:inherit;font-size:13.5px;font-weight:700;border-radius:8px;cursor:pointer;transition:all .2s}
  .seg-toggle button.active{background:linear-gradient(180deg,var(--green),#14d68f);color:#04130b;box-shadow:0 4px 14px rgba(24,242,162,0.4)}
  .calc-out .v .u{font-size:20px;color:var(--green);margin-left:9px;font-weight:700}

  /* ════ FAQ ════ */
  .faq-list{max-width:840px;margin:0 auto;display:flex;flex-direction:column;gap:12px}
  .faq{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:border-color .25s,background .25s}
  .faq[open]{border-color:rgba(24,242,162,0.28);background:rgba(24,242,162,0.02)}
  .faq summary{list-style:none;cursor:pointer;padding:21px 24px;display:flex;align-items:center;gap:16px;font-family:'Space Grotesk';font-size:16.5px;font-weight:700;color:var(--text);line-height:1.35}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary .q{flex:1}
  .faq summary .ico{flex-shrink:0;width:28px;height:28px;border-radius:8px;background:rgba(24,242,162,0.1);border:1px solid rgba(24,242,162,0.25);color:var(--green);display:flex;align-items:center;justify-content:center;transition:transform .3s cubic-bezier(.16,1,.3,1)}
  .faq[open] summary .ico{transform:rotate(135deg)}
  .faq .a{padding:0 24px 22px 68px;font-size:14.5px;color:var(--mute);line-height:1.68;max-width:700px}

  /* ════ FINAL ════ */
  .final{position:relative;padding:170px 0 130px;text-align:center;overflow:hidden}
  .final::before{content:'';position:absolute;width:900px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(24,242,162,0.2),transparent 60%);left:50%;top:12%;transform:translateX(-50%);z-index:0}
  .final h2{font-size:clamp(36px,5vw,64px);font-weight:800;letter-spacing:-0.04em;line-height:1.04;margin-bottom:18px}
  .final p{font-size:17px;color:var(--mute);max-width:520px;margin:0 auto 36px}
  footer{padding:40px 0;border-top:1px solid var(--border);position:relative;z-index:2}
  .fi{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;max-width:1240px;margin:0 auto;padding:0 32px}
  .fl{display:flex;gap:24px;font-size:13px}
  .fl a{color:var(--mute);text-decoration:none}.fl a:hover{color:var(--text)}
  .fc{font-size:12.5px;color:var(--dim)}

  @media (max-width:980px){
    .cx-card{position:relative;top:0}
    .hero-inner{grid-template-columns:1fr;gap:44px}
    .cx-stage{grid-template-columns:1fr;gap:22px}
    .cx-picker{display:grid;grid-template-columns:1fr 1fr;gap:9px}
    .pipe{grid-template-columns:1fr 1fr;gap:40px 0}
    .pipe-line{display:none}
    .gate-grid{grid-template-columns:1fr 1fr}
    .earn-grid{grid-template-columns:1fr;gap:36px}
  }
  @media (max-width:620px){
    .container{padding:0 22px}
    .section{padding:84px 0}
    .hero-stats{gap:22px;flex-wrap:wrap}
    .cx-picker{grid-template-columns:1fr}
    .pipe{grid-template-columns:1fr}
    .gate-grid{grid-template-columns:1fr}
    .comp-metrics,.cx-metrics{grid-template-columns:repeat(2,1fr)}
    nav .links,.scene-nav{display:none}
    .cx-sentence{font-size:13px}
    .faq .a{padding-left:24px}
    .faq summary{font-size:15px}
    .cv{flex-direction: column;}
  }
  .cx-accordion{display:none}
  @media (max-width:980px){
    .cx-stage{display:none}
    .cx-accordion{display:flex;flex-direction:column;gap:10px}
    .cx-acc-item{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden;transition:border-color .25s,background .25s}
    .cx-acc-item[open]{border-color:rgba(24,242,162,0.35);background:rgba(24,242,162,0.03)}
    .cx-acc-item summary{list-style:none;cursor:pointer;padding:16px 18px;display:flex;align-items:center;gap:13px}
    .cx-acc-item summary::-webkit-details-marker{display:none}
    .cx-acc-item summary .ci{width:36px;height:36px;border-radius:10px;flex-shrink:0;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,0.04);border:1px solid var(--border);color:var(--mute)}
    .cx-acc-item[open] summary .ci{background:linear-gradient(135deg,rgba(24,242,162,0.18),transparent);border-color:rgba(24,242,162,0.35);color:var(--green)}
    .cx-acc-item summary .cl{flex:1;font-family:'Space Grotesk';font-weight:700;font-size:14.5px}
    .cx-acc-item summary .cs{display:block;font-size:11.5px;font-weight:500;color:var(--dim);margin-top:2px}
    .cx-acc-item summary .ico{flex-shrink:0;width:24px;height:24px;border-radius:7px;background:rgba(24,242,162,0.1);border:1px solid rgba(24,242,162,0.25);color:var(--green);display:flex;align-items:center;justify-content:center;transition:transform .3s cubic-bezier(.16,1,.3,1)}
    .cx-acc-item[open] summary .ico{transform:rotate(135deg)}
    .cx-acc-item .body{padding:0 18px 20px}
  }
</style>
</head>


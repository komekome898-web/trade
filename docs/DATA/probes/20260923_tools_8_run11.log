/* infrastructure stack */
.algr-slip .stack{max-width:460px;margin:0 auto}
.algr-slip .layer{display:flex;gap:14px;align-items:center;padding:13px 18px;border-radius:8px;margin:5px 0;color:#fff}
.algr-slip .layer .ln{font-size:12px;opacity:.85}

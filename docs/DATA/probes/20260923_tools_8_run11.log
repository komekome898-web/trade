   Reuse for every article: wrap the post HTML in <div class="algr-article">.
   Everything is scoped under .algr-article and is safe on dark themes
   (light cards declare their own dark text + solid background).
   ===================================================================== */

.algr-article{max-width:840px;margin:0 auto}
.algr-article *{box-sizing:border-box}

/* spacing only — body text & headings inherit your theme fonts/colors */

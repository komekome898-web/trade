          <span class="fn" id="cxFn">strategy.algo</span>
          <span class="ok"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> compiled · backtested · forward-tested</span>
        </div>

$ cat -n /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-042/src/examples/build_lcl_cache.py
     1	"""Rebuild the cached 60-household LCL extract from the public dataset.
     2	
     3	The selection-regret experiments
     4	(``selection_regret_lcl_seeds.py``, ``selection_regret_lcl_targetenc.py``) read a
     5	cached half-hourly extract at ``examples/data/lcl_halfhourly.csv`` with columns
     6	``LCLid, tstp, energy_kwh``. That file is ~68 MB and is git-ignored, so it is not
     7	redistributed. This script rebuilds *that exact extract* from the public Low
     8	Carbon London dataset, using the committed household manifest
     9	``examples/lcl_household_manifest.csv`` (the 60 ``LCLid`` values), so every
    10	reported number is reproducible from public data alone.
    11	
    12	Public data
    13	-----------
    14	Download "SmartMeter Energy Consumption Data in London Households (Low Carbon
    15	London)" from the London Datastore:
    16	
    17	    https://data.london.gov.uk/dataset/smartmeter-energy-use-data-in-london-households
    18	
    19	You may use either layout:
    20	  * the single combined file ``CC_LCL-FullData.csv``; or
    21	  * the directory of block files ``Power-Networks-LCL-June2015(withAcornGps)v2_*.csv``.
    22	
    23	The public files carry columns ``LCLid``, ``stdorToU``, ``DateTime``, and
    24	``KWH/hh (per half hour)`` (plus Acorn fields we ignore). The half-hourly reading
    25	column contains occasional ``Null`` strings; those become NaN and are skipped by
    26	the daily aggregation in ``load_daily``, so they do not affect any reported total.
    27	
    28	Usage
    29	-----
    30	    python examples/build_lcl_cache.py --source /path/to/CC_LCL-FullData.csv
    31	    python examples/build_lcl_cache.py --source /path/to/lcl_block_dir/
    32	    python examples/build_lcl_cache.py --source ... --verify   # check against an
    33	                                                               # existing cache
    34	
    35	The output is written to ``examples/data/lcl_halfhourly.csv`` (created if needed).
    36	``--verify`` additionally compares the rebuilt daily-per-household totals over all
    37	dates (so both the pre-2013 prior data and the in-window feature data are checked)
    38	against an existing cache, and exits non-zero on any mismatch.
    39	"""
    40	
    41	from __future__ import annotations
    42	
    43	import argparse
    44	from pathlib import Path
    45	
    46	import numpy as np
    47	import pandas as pd
    48	
    49	REPO = Path(__file__).resolve().parent
    50	MANIFEST = REPO / "lcl_household_manifest.csv"
    51	OUT = REPO / "data" / "lcl_halfhourly.csv"
    52	CHUNK = 2_000_000
    53	
    54	
    55	def _detect(cols: list[str]) -> tuple[str, str, str]:
    56	    """Return (id_col, time_col, kwh_col) for raw-public or already-renamed files."""
    57	    low = {c.lower().strip(): c for c in cols}
    58	    id_col = low.get("lclid")
    59	    time_col = low.get("datetime") or low.get("tstp")
    60	    kwh_col = next((c for c in cols if "kwh" in c.lower() or c.lower() == "energy_kwh"), None)
    61	    if not (id_col and time_col and kwh_col):
    62	        raise ValueError(f"could not locate LCLid/DateTime/KWH columns in {cols}")
    63	    return id_col, time_col, kwh_col
    64	
    65	
    66	def _iter_sources(source: Path):
    67	    if source.is_dir():
    68	        files = sorted(source.glob("*.csv"))
    69	        if not files:
    70	            raise FileNotFoundError(f"no CSV files under {source}")
    71	        yield from files
    72	    else:
    73	        yield source
    74	
    75	
    76	def build(source: Path, manifest: Path, out: Path) -> pd.DataFrame:
    77	    ids = set(pd.read_csv(manifest)["LCLid"])
    78	    if len(ids) != 60:
    79	        raise ValueError(f"manifest must list 60 households, found {len(ids)}")
    80	    parts: list[pd.DataFrame] = []
    81	    for path in _iter_sources(source):
    82	        for chunk in pd.read_csv(path, chunksize=CHUNK, dtype=str):
    83	            id_col, time_col, kwh_col = _detect(list(chunk.columns))
    84	            sub = chunk[chunk[id_col].isin(ids)]
    85	            if sub.empty:
    86	                continue
    87	            parts.append(
    88	                pd.DataFrame(
    89	                    {
    90	                        "LCLid": sub[id_col].to_numpy(),
    91	                        "tstp": pd.to_datetime(sub[time_col], errors="coerce"),
    92	                        "energy_kwh": pd.to_numeric(sub[kwh_col], errors="coerce"),
    93	                    }
    94	                )
    95	            )
    96	    if not parts:
    97	        raise RuntimeError("no rows matched the manifest; check the --source path/schema")
    98	    df = pd.concat(parts, ignore_index=True)
    99	    df = df.dropna(subset=["tstp"]).sort_values(["LCLid", "tstp"]).reset_index(drop=True)
   100	    found = df["LCLid"].nunique()
   101	    if found != 60:
   102	        raise RuntimeError(f"matched {found}/60 manifest households; the source is "
   103	                           "incomplete, so the rebuilt extract would not reproduce the experiment")
   104	    out.parent.mkdir(parents=True, exist_ok=True)
   105	    df.to_csv(out, index=False)
   106	    print(f"wrote {out} ({len(df):,} rows, {found} households)")
   107	    return df
   108	
   109	
   110	def _daily(df: pd.DataFrame) -> pd.DataFrame:
   111	    d = df.copy()
   112	    d["date"] = d["tstp"].dt.normalize()
   113	    return (
   114	        d.groupby(["LCLid", "date"])["energy_kwh"].sum().reset_index()
   115	        .sort_values(["LCLid", "date"]).reset_index(drop=True)
   116	    )
   117	
   118	
   119	def verify(rebuilt: pd.DataFrame, reference: Path) -> bool:
   120	    """Compare rebuilt daily totals against the reference over *all* dates, so both
   121	    the pre-2013 prior data and the in-window feature data are checked."""
   122	    ref = pd.read_csv(reference, parse_dates=["tstp"])
   123	    a, b = _daily(rebuilt), _daily(ref)
   124	    ok = (
   125	        a.shape == b.shape
   126	        and a["LCLid"].equals(b["LCLid"]) and a["date"].equals(b["date"])
   127	        and np.allclose(a["energy_kwh"].to_numpy(), b["energy_kwh"].to_numpy(), atol=1e-9)
   128	    )
   129	    print("VERIFY OK: rebuilt daily totals (pre-2013 and in-window) match the reference cache exactly"
   130	          if ok else "VERIFY FAIL: rebuilt daily totals differ from the reference cache")
   131	    return ok
   132	
   133	
   134	def main() -> None:
   135	    ap = argparse.ArgumentParser(description=__doc__)
   136	    ap.add_argument("--source", required=True, type=Path,
   137	                    help="public LCL FullData CSV or directory of block CSVs")
   138	    ap.add_argument("--manifest", type=Path, default=MANIFEST)
   139	    ap.add_argument("--out", type=Path, default=OUT)
   140	    ap.add_argument("--verify", action="store_true",
   141	                    help="compare rebuilt daily totals (pre-2013 and in-window) against --out "
   142	                         "if it already exists; exit non-zero on mismatch")
   143	    args = ap.parse_args()
   144	    existing = args.out if args.out.exists() else None
   145	    df = build(args.source, args.manifest, args.out if not (args.verify and existing) else
   146	               args.out.with_suffix(".rebuilt.csv"))
   147	    if args.verify and existing and not verify(df, existing):
   148	        raise SystemExit(1)
   149	
   150	
   151	if __name__ == "__main__":
   152	    main()
--- 2026-09-27T08:47:11Z method=読了 target=purged-cross-validation rc=0 time_s=0.004 note=E1a段: competitor_benchmark.pyの docstring・main・引数全文 [sandbox /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-042/sb46]
$ cat -n /tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-042/src/tools/competitor_benchmark.py
     1	"""Controlled leakage benchmark: purgedcv vs competitor CV splitters.
     2	
     3	Cross-validation splitters are not models -- they are leakage controls. So a
     4	fair comparison is not "whose accuracy is higher" but "how much leakage does
     5	each splitter admit on a task whose honest answer is known". We reuse the
     6	controlled construction from ``examples/synthetic_leakage_proof.ipynb``:
     7	
     8	  * the target is the mean of the next H pure-noise draws -> nothing can
     9	    predict it, the honest R^2 is ~0 (or negative);
    10	  * the only feature is a monotone cumulative "clock" with no real link to
    11	    the target.
    12	
    13	Any clearly positive R^2 on this task is fabricated -- it is the train/test
    14	label overlap leaking the answer. We run the *same model* through each
    15	competitor's splitter and record:
    16	
    17	  * mean R^2 it reports (<= ~0 is honest; large positive is leakage);
    18	  * mean train/test label-overlap fraction it admits, measured with the
    19	    tool-neutral ``purgedcv.diagnostics.compute_overlap_fraction`` (an
    20	    interval-overlap count, independent of which library produced the folds).
    21	
    22	Competitors that do not install/run on a modern stack, or are closed-source,
    23	are NOT guessed at: each splitter is isolated, and a failure is recorded with
    24	its exact reason. Deterministic; the script is tracked under ``tools/`` but
    25	never imported by the library. Writes (git-ignored)
    26	``examples/data/competitor_benchmark.csv`` and ``..._summary.md``.
    27	"""
    28	
    29	from __future__ import annotations
    30	
    31	import argparse
    32	import sys
    33	from collections.abc import Callable
    34	from pathlib import Path
    35	from typing import Any
    36	
    37	import numpy as np
    38	import pandas as pd
    39	from sklearn.ensemble import RandomForestRegressor
    40	from sklearn.metrics import r2_score
    41	from sklearn.model_selection import KFold, TimeSeriesSplit
    42	
    43	EXAMPLES = Path(__file__).resolve().parent.parent / "examples"
    44	if str(EXAMPLES.parent) not in sys.path:
    45	    sys.path.insert(0, str(EXAMPLES.parent))
    46	
    47	from purgedcv import CombinatorialPurgedCV, PurgedKFold, WalkForwardSplit  # noqa: E402
    48	from purgedcv.diagnostics import compute_overlap_fraction  # noqa: E402
    49	
    50	SEED = 0
    51	N = 1500
    52	H = 20
    53	N_SPLITS = 5
    54	
    55	Folds = list[tuple[np.ndarray, np.ndarray]]
    56	
    57	
    58	def make_dataset() -> tuple[np.ndarray, np.ndarray, pd.Series, pd.Series]:
    59	    """Target depends only on noise (unpredictable); feature is a clock."""
    60	    rng = np.random.default_rng(SEED)
    61	    e = rng.standard_normal(N + H)
    62	    y = np.array([e[t : t + H].mean() for t in range(N)])
    63	    x = np.cumsum(rng.gamma(shape=2.0, scale=1.0, size=N))
    64	    features = x.reshape(-1, 1)
    65	    pred = pd.Series(pd.date_range("2020-01-01", periods=N, freq="D"))
    66	    evalu = pred + pd.Timedelta(days=H)
    67	    return features, y, pred, evalu
    68	
    69	
    70	def score_folds(features: np.ndarray, y: np.ndarray, folds: Folds) -> float:
    71	    """Mean out-of-fold R^2 of one fixed model across the given folds."""
    72	    scores: list[float] = []
    73	    for tr, te in folds:
    74	        if len(tr) == 0 or len(te) == 0:
    75	            continue
    76	        model = RandomForestRegressor(n_estimators=120, random_state=SEED)
    77	        model.fit(features[tr], y[tr])
    78	        scores.append(float(r2_score(y[te], model.predict(features[te]))))
    79	    return float(np.mean(scores)) if scores else float("nan")
    80	
    81	
    82	def mean_overlap(folds: Folds, pred: pd.Series, evalu: pd.Series) -> float:
    83	    fr = [compute_overlap_fraction(tr, te, pred, evalu) for tr, te in folds if len(tr) and len(te)]
    84	    return float(np.mean(fr)) if fr else float("nan")
    85	
    86	
    87	def _arr(pairs: Any) -> Folds:
    88	    return [(np.asarray(tr), np.asarray(te)) for tr, te in pairs]
    89	
    90	
    91	# Each builder takes (features, y, pred, evalu) and returns folds, or raises.
    92	# Builders are isolated per splitter so one bad/absent library never hides the
    93	# others and never produces a fabricated number.
    94	
    95	
    96	def _sk_kfold_shuffle(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
    97	    return _arr(KFold(n_splits=N_SPLITS, shuffle=True, random_state=SEED).split(f))
    98	
    99	
   100	def _sk_kfold_blocked(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   101	    return _arr(KFold(n_splits=N_SPLITS, shuffle=False).split(f))
   102	
   103	
   104	def _sk_tss(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   105	    return _arr(TimeSeriesSplit(n_splits=N_SPLITS).split(f))
   106	
   107	
   108	def _sk_tss_gap(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   109	    return _arr(TimeSeriesSplit(n_splits=N_SPLITS, gap=H).split(f))
   110	
   111	
   112	def _pcv_purged(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   113	    cv = PurgedKFold(
   114	        n_splits=N_SPLITS,
   115	        prediction_times=p,
   116	        evaluation_times=e,
   117	        purge_horizon=f"{H}D",
   118	        embargo=f"{H}D",
   119	    )
   120	    return _arr(cv.split(f))
   121	
   122	
   123	def _pcv_walk(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   124	    cv = WalkForwardSplit(
   125	        n_splits=N_SPLITS,
   126	        test_size=N // (N_SPLITS + 1),
   127	        window="expanding",
   128	        prediction_times=p,
   129	        evaluation_times=e,
   130	        purge_horizon=f"{H}D",
   131	    )
   132	    return _arr(cv.split(f))
   133	
   134	
   135	def _pcv_cpcv(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   136	    cv = CombinatorialPurgedCV(
   137	        n_splits=6,
   138	        n_test_groups=2,
   139	        prediction_times=p,
   140	        evaluation_times=e,
   141	        purge_horizon=f"{H}D",
   142	    )
   143	    return _arr(cv.split(f))
   144	
   145	
   146	def _tscv_gapkfold(f: np.ndarray, y: np.ndarray, p: pd.Series, e: pd.Series) -> Folds:
   147	    from tscv import GapKFold

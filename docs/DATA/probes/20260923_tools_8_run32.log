$ python3 -c "
import subprocess
data = open('/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-034/list.txt','rb').read()
paths = [p.decode('utf-8','surrogateescape') for p in data.split(b'\x00') if p.strip()]
pat = r'リプレイ|再生|replay|record|記録|capture|playback|再実行|rerun'
total_lines = 0
files_with_hits = 0
for p in paths:
    r = subprocess.run(['grep','-I','-c','-i','-E',pat,p], capture_output=True, text=True)
    n = int(r.stdout.strip() or 0)
    if n>0:
        total_lines += n; files_with_hits += 1
print('files=', len(paths), 'files_with_hits=', files_with_hits, 'total_lines=', total_lines)
"

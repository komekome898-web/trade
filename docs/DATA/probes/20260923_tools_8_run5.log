<th id="S4.T1.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt">Rebal.</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.2.2" class="ltx_tr">
<td id="S4.T1.2.2.1" class="ltx_td ltx_align_left ltx_border_t">BM01</td>
<td id="S4.T1.2.2.2" class="ltx_td ltx_align_left ltx_border_t">equal-weight monthly</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t">simple</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_t">baseline (18 bps)</td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_right ltx_border_t">monthly</td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_left">BM02</td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_left">stay-drift (buy-and-hold)</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_left">simple</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_left">baseline (18 bps)</td>
<td id="S4.T1.2.3.5" class="ltx_td ltx_align_right">once</td></tr>
<tr id="S4.T1.2.4" class="ltx_tr">
<td id="S4.T1.2.4.1" class="ltx_td ltx_align_left">BM03</td>
<td id="S4.T1.2.4.2" class="ltx_td ltx_align_left">large rotation</td>
<td id="S4.T1.2.4.3" class="ltx_td ltx_align_left">rotation</td>
<td id="S4.T1.2.4.4" class="ltx_td ltx_align_left">baseline (18 bps)</td>
<td id="S4.T1.2.4.5" class="ltx_td ltx_align_right">monthly</td></tr>

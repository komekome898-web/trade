import numpy as np, pandas as pd, socket, time, json
_orig_connect = socket.socket.connect
_calls = [0]
def _blocked_connect(self, *a, **k):
    _calls[0] += 1
    raise OSError('blocked for test')
socket.socket.connect = _blocked_connect

t0=time.time()
from purgedcv import purge, apply_embargo, PurgedKFold, audit_splitter, probabilistic_sharpe_ratio, deflated_sharpe_ratio, probability_of_backtest_overfitting
from purgedcv.diagnostics import assert_no_temporal_leakage, compute_overlap_fraction
from purgedcv.exceptions import TemporalLeakageError
import purgedcv
print('__version__', purgedcv.__version__)
print('__file__', purgedcv.__file__)

# E3b: purge drops overlapping rows (docstring example)
pred = pd.Series(pd.date_range('2024-01-01', periods=10, freq='D'))
evalu = pred + pd.Timedelta(days=3)
train_idx = np.array([0,1,2,3,4,8,9]); test_idx = np.array([5,6,7])
kept = purge(train_idx, test_idx, pred, evalu)
print('purge_kept', kept.tolist())
assert kept.tolist() == [0,1,2]

# E3a PASS: clean split -> no exception, overlap 0
train2 = np.arange(0,5); test2 = np.arange(10,15)
pred20 = pd.Series(pd.date_range('2024-01-01', periods=20, freq='D'))
evalu20 = pred20 + pd.Timedelta(days=1)
try:
    assert_no_temporal_leakage(train2, test2, pred20, evalu20)
    pass_ok = True
except TemporalLeakageError as e:
    pass_ok = False
of_pass = compute_overlap_fraction(train2, test2, pred20, evalu20)
print('PASS_case overlap_fraction', of_pass, 'assert_ok', pass_ok)

# E3a FAIL: overlapping split -> raises
train3 = np.arange(10,15); test3 = np.arange(10,15)
fail_raised = False
try:
    assert_no_temporal_leakage(train3, test3, pred20, evalu20)
except TemporalLeakageError as e:
    fail_raised = True
    fail_msg = str(e)
of_fail = compute_overlap_fraction(train3, test3, pred20, evalu20)
print('FAIL_case overlap_fraction', of_fail, 'raised', fail_raised, 'msg', fail_msg[:80])

# audit_splitter (E3a, own-framework)
cv = PurgedKFold(4, prediction_times=pred20, evaluation_times=evalu20, purge_horizon='1D', embargo_observations=2)
X = np.zeros((20,1))
report = audit_splitter(cv, X)
print('audit_rows', report.shape[0], 'final_overlap_all_zero', bool(report['final_overlap_fraction'].eq(0.0).all()))

# E1b: default_backtest_metrics via path_metrics
from purgedcv import path_metrics
paths = np.array([[0.01,-0.02,0.03,0.0],[0.0,0.01,0.01,0.01]])
dfm = path_metrics(paths)
print('path_metrics_cols', list(dfm.columns))
print('path_metrics_row0', dfm.iloc[0].to_dict())

# E6: PSR/DSR/PBO
rng = np.random.default_rng(0)
returns = rng.normal(0.001, 0.01, 252)
psr = probabilistic_sharpe_ratio(returns, benchmark_skill=0.0)
print('psr', psr)
dsr = deflated_sharpe_ratio(0.9, n_trials=50, var_sharpe=0.01)

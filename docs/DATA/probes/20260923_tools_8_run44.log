import gzip, io, csv, numpy as np, pandas as pd
from purgedcv import PurgedKFold

# tardis形式を模した合成の約定csv.gz(timestamp_ms,symbol,side,price,amount)
buf = io.BytesIO()
with gzip.GzipFile(fileobj=buf, mode='wb') as gz:
    w = io.TextIOWrapper(gz, encoding='utf-8')
    wcsv = csv.writer(w)
    wcsv.writerow(['timestamp_ms','symbol','side','price','amount'])
    base = 1700000000000
    for i in range(500):
        wcsv.writerow([base + i*1000, 'BTCJPY', 'buy' if i%2==0 else 'sell', 5000000+i, 0.01])
    w.flush()
raw = buf.getvalue()
print('csv_gz_bytes', len(raw))

with gzip.GzipFile(fileobj=io.BytesIO(raw), mode='rb') as gz:
    df = pd.read_csv(gz)
print('rows_read', len(df))
# ミリ秒epochをUTC datetime64に変換(tz-aware入力はUTCに正規化されるとdocs/installation.mdにある)
ts = pd.to_datetime(df['timestamp_ms'], unit='ms', utc=True)
pred = ts
evalu = ts + pd.Timedelta(seconds=5)  # 5秒後に評価するラベル、という設定
n = len(df)
train_idx = np.arange(0, 400)
test_idx = np.arange(400, 450)
cv = PurgedKFold(n_splits=5, prediction_times=pred, evaluation_times=evalu, purge_horizon='5s')
folds = list(cv.split(np.zeros((n,1))))
print('n_folds', len(folds))
print('fold0_train_len', len(folds[0][0]), 'fold0_test_len', len(folds[0][1]))
print('pred_dtype', pred.dtype)

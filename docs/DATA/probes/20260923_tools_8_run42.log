    53	
    54	function readReplayMessage(record: Record<string, unknown>): Record<string, unknown> | undefined {
    55	  if (isRecord(record.message)) {
    56	    return record.message;
    57	  }
    58	  return normalizeOptionalString(record.role) ? record : undefined;
    59	}
    60	
    61	function readRole(message: Record<string, unknown>) {
    62	  return normalizeOptionalString(message.role)?.toLowerCase();
    63	}
    64	
    65	function isTextLikeContentBlock(block: Record<string, unknown>) {
    66	  const type = normalizeOptionalString(block.type)?.toLowerCase();
    67	  return (
    68	    !type ||
    69	    type === "text" ||
    70	    type === "input_text" ||
    71	    type === "message" ||
    72	    type === "output_text" ||
    73	    type === "user_text"
    74	  );
    75	}
    76	
    77	function extractTextContent(content: unknown): string {
    78	  if (typeof content === "string") {
    79	    return content.trim();
    80	  }
    81	  if (!Array.isArray(content)) {
    82	    return "";
    83	  }
    84	  const parts: string[] = [];
    85	  for (const block of content) {
    86	    if (typeof block === "string") {
    87	      if (block.trim()) {
    88	        parts.push(block.trim());
    89	      }
    90	      continue;
    91	    }
    92	    if (!isRecord(block) || !isTextLikeContentBlock(block)) {
    93	      continue;
    94	    }
    95	    const text = normalizeOptionalString(block.text) ?? normalizeOptionalString(block.content);
    96	    if (text) {
    97	      parts.push(text);
    98	    }
    99	  }
   100	  return parts.join("\n").trim();
   101	}
   102	
   103	function extractJsonlReplayUserTurns(transcriptBytes: string): JsonlReplayTurn[] {
   104	  const turns: JsonlReplayTurn[] = [];
   105	  const acceptedLines: string[] = [];
   106	  for (const [lineIndex, rawLine] of transcriptBytes.split(/\r?\n/u).entries()) {
   107	    const trimmed = rawLine.trim();
   108	    if (!trimmed) {
   109	      continue;
   110	    }
   111	    let parsed: unknown;
   112	    try {
   113	      parsed = JSON.parse(trimmed) as unknown;
   114	    } catch {
   115	      continue;
   116	    }
   117	    if (!isRecord(parsed)) {
   118	      continue;
   119	    }
   120	    acceptedLines.push(trimmed);
   121	    const message = readReplayMessage(parsed);
   122	    if (!message || readRole(message) !== "user") {
   123	      continue;
   124	    }
   125	    const userText = extractTextContent(message.content);
   126	    if (!userText) {
   127	      continue;
   128	    }
   129	    turns.push({
   130	      turn: turns.length + 1,
   131	      lineNumber: lineIndex + 1,
   132	      userText,
   133	      transcriptPrefix: `${acceptedLines.join("\n")}\n`,
   134	    });
   135	  }
   136	  return turns;
   137	}
   138	
   139	async function listJsonlFiles(directory: string): Promise<string[]> {
   140	  const entries = await fs.readdir(directory, { withFileTypes: true });
   141	  const files: string[] = [];
   142	  for (const entry of entries.toSorted((left, right) => left.name.localeCompare(right.name))) {
   143	    const entryPath = path.join(directory, entry.name);
   144	    if (entry.isDirectory()) {
   145	      files.push(...(await listJsonlFiles(entryPath)));
   146	      continue;
   147	    }
   148	    if (entry.isFile() && entry.name.endsWith(".jsonl")) {
   149	      files.push(entryPath);
   150	    }
   151	  }
   152	  return files;
   153	}
   154	
   155	function defaultRunCell(): Promise<RuntimeParityScenarioExecution> {
   156	  throw new Error(
   157	    "jsonl replay requires a runtime cell runner; CLI/suite wiring should provide the Phase 1 runtime parity runner",
   158	  );
   159	}
   160	
   161	function assertSupportedRuntimePair(runtimePair: JsonlReplayInput["runtimePair"]) {
   162	  if (runtimePair[0] !== "openclaw" || runtimePair[1] !== "codex") {
   163	    throw new Error(`unsupported jsonl replay runtime pair: ${runtimePair.join(",")}`);
   164	  }
   165	}
   166	
   167	export function createMockJsonlReplayCellRunner(): JsonlReplayCellRunner {
   168	  return async ({ runtime, turn }) => ({
   169	    status: "pass",
   170	    cell: {
   171	      runtime,
   172	      transcriptBytes: turn.transcriptPrefix,
   173	      toolCalls: [],
   174	      finalText: `Replayed curated turn ${turn.turn}.`,
   175	      usage: {
   176	        inputTokens: Math.max(1, Math.ceil(turn.transcriptPrefix.length / 4)),
   177	        outputTokens: 8,
   178	        totalTokens: Math.max(1, Math.ceil(turn.transcriptPrefix.length / 4)) + 8,
   179	      },
   180	      wallClockMs: 1,
   181	      bootStateLines: [],
   182	    },
   183	  });
   184	}
   185	
   186	export async function runJsonlReplay(
   187	  input: JsonlReplayInput,
   188	  options: JsonlReplayOptions = {},
   189	): Promise<JsonlReplayResult> {
   190	  assertSupportedRuntimePair(input.runtimePair);
   191	  const directory = path.resolve(input.directory);
   192	  const transcriptPaths = await listJsonlFiles(directory);
   193	  const runCell = options.runCell ?? defaultRunCell;
   194	  const transcripts: JsonlReplayResult["transcripts"] = [];
   195	
   196	  for (const transcriptPath of transcriptPaths) {
   197	    const transcriptBytes = await fs.readFile(transcriptPath, "utf8");
   198	    const turns = extractJsonlReplayUserTurns(transcriptBytes);
   199	    const cells: { openclaw: RuntimeParityCell[]; codex: RuntimeParityCell[] } = {
   200	      openclaw: [],
   201	      codex: [],
   202	    };
   203	    const drift: Array<RuntimeParityResult["drift"]> = [];
   204	    let firstDriftAtTurn: number | undefined;
   205	
   206	    for (const turn of turns) {
   207	      const parity = await runRuntimeParityScenario({
   208	        scenarioId: `${path.basename(transcriptPath)}#turn-${turn.turn}`,
   209	        runCell: async (runtime) =>
   210	          runCell({
   211	            runtime,
   212	            transcriptPath,
   213	            turn,
   214	            turns,
   215	            providerMode: input.providerMode,
   216	          }),
   217	      });
   218	      cells.openclaw.push(parity.cells.openclaw);
   219	      cells.codex.push(parity.cells.codex);
   220	      drift.push(parity.drift);
   221	      if (firstDriftAtTurn === undefined && parity.drift !== "none") {
   222	        firstDriftAtTurn = turn.turn;
   223	      }
   224	    }
   225	
   226	    transcripts.push({
   227	      transcriptPath,
   228	      userTurnCount: turns.length,
   229	      cells,
   230	      drift,
   231	      ...(firstDriftAtTurn !== undefined ? { firstDriftAtTurn } : {}),
   232	    });
   233	  }
   234	
   235	  return { transcripts };
   236	}
   237	
   238	export function renderJsonlReplayMarkdownReport(report: JsonlReplayMarkdownReport): string {
   239	  const totalTurns = report.transcripts.reduce((sum, entry) => sum + entry.userTurnCount, 0);
   240	  const driftedTranscripts = report.transcripts.filter(
   241	    (entry) => entry.firstDriftAtTurn !== undefined,
   242	  );
   243	  const lines = [
   244	    `# OpenClaw JSONL Replay Report - ${report.runtimePair[0]} vs ${report.runtimePair[1]}`,
   245	    "",
   246	    `- Generated at: ${report.generatedAt}`,
   247	    `- Provider mode: ${report.providerMode}`,
   248	    `- Transcripts: ${report.transcripts.length}`,
   249	    `- User turns: ${totalTurns}`,
   250	    `- Drifted transcripts: ${driftedTranscripts.length}`,
   251	    "",
   252	    "| Transcript | User turns | First drift turn | Drift sequence |",
   253	    "| --- | ---: | ---: | --- |",
   254	  ];
   255	
   256	  for (const transcript of report.transcripts) {
   257	    lines.push(
   258	      `| ${path.basename(transcript.transcriptPath)} | ${transcript.userTurnCount} | ${transcript.firstDriftAtTurn ?? ""} | ${transcript.drift.join(", ")} |`,
   259	    );
   260	  }
   261	

     1	// In-memory dedupe helpers for plugin runtime hot paths.
     2	
     3	import { resolveGlobalDedupeCache } from "../infra/dedupe.js";
     4	import type { OpenKeyedStoreOptions } from "./plugin-state-runtime.js";
     5	
     6	export { createDedupeCache, resolveGlobalDedupeCache } from "../infra/dedupe.js";
     7	
     8	type PersistentDedupeStore<TRecord> = {
     9	  register(key: string, value: TRecord, opts?: { ttlMs?: number }): Promise<void>;
    10	  lookup(key: string): Promise<TRecord | undefined>;
    11	};
    12	
    13	type PersistentDedupeEntryMetadata = {
    14	  key: string;
    15	  expiresAt?: number;
    16	};
    17	
    18	/** Dual-layer presence cache: process-memory dedupe plus best-effort persistent state. */
    19	export type PersistentDedupeCache<TRecord> = {
    20	  /** Memory-only presence check without refreshing recency. */
    21	  peek(key: string): boolean;
    22	  /** Memory-first presence check; falls back to persistence and re-primes memory on a hit. */
    23	  lookup(key: string): Promise<boolean>;
    24	  /** Records presence in memory and best-effort persistence. Never rejects. */
    25	  register(key: string, record: TRecord, opts?: { at?: number }): Promise<void>;
    26	  /** Clears memory and re-enables a persistent layer disabled by an earlier failure. */
    27	  clearForTest(): void;
    28	};
    29	
    30	/**
    31	 * Creates a channel-family presence cache backed by a global in-memory dedupe layer
    32	 * plus a lazily opened plugin keyed store. Persistence is best effort: the first
    33	 * open/read/write failure disables the persistent layer for the process so message
    34	 * handling never breaks on state errors, matching the shipped channel-cache contract.
    35	 */
    36	export function createPersistentDedupeCache<TRecord>(params: {
    37	  /** Global symbol key so the memory layer stays shared across bundled chunks. */
    38	  globalKey: symbol;
    39	  ttlMs: number;
    40	  maxSize: number;
    41	  persistent: {
    42	    namespace: string;
    43	    maxEntries: number;
    44	    /** Usually `() => runtime?.state.openKeyedStore(options)`; undefined skips persistence. */
    45	    openStore: (options: OpenKeyedStoreOptions) => PersistentDedupeStore<TRecord> | undefined;
    46	    logError?: (error: unknown) => void;
    47	    /** Memory re-prime timestamp after a persistent hit; defaults to now. */
    48	    readTimestamp?: (record: TRecord) => number | undefined;
    49	  };
    50	}): PersistentDedupeCache<TRecord> {
    51	  const memory = resolveGlobalDedupeCache(params.globalKey, {
    52	    ttlMs: params.ttlMs,
    53	    maxSize: params.maxSize,
    54	  });
    55	  let persistentStore: PersistentDedupeStore<TRecord> | undefined;
    56	  let persistentStoreDisabled = false;
    57	
    58	  const disablePersistentStore = (error: unknown) => {
    59	    persistentStoreDisabled = true;
    60	    persistentStore = undefined;
    61	    params.persistent.logError?.(error);
    62	  };
    63	
    64	  const getPersistentStore = (): PersistentDedupeStore<TRecord> | undefined => {
    65	    if (persistentStoreDisabled) {
    66	      return undefined;
    67	    }
    68	    if (persistentStore) {
    69	      return persistentStore;
    70	    }
    71	    try {
    72	      persistentStore = params.persistent.openStore({
    73	        namespace: params.persistent.namespace,
    74	        maxEntries: params.persistent.maxEntries,
    75	        ...(params.ttlMs > 0 ? { defaultTtlMs: params.ttlMs } : {}),
    76	      });
    77	      return persistentStore;
    78	    } catch (error) {
    79	      disablePersistentStore(error);
    80	      return undefined;
    81	    }
    82	  };
    83	
    84	  return {
    85	    peek: (key) => memory.peek(key),
    86	    lookup: async (key) => {
    87	      if (memory.peek(key)) {
    88	        return true;
    89	      }
    90	      const store = getPersistentStore();
    91	      if (!store) {
    92	        return false;
    93	      }
    94	      let record: TRecord | undefined;
    95	      try {
    96	        record = await store.lookup(key);
    97	        if (record === undefined) {
    98	          return false;
    99	        }
   100	        if (params.ttlMs <= 0) {
   101	          const metadataStore = store as {
   102	            entries?: () => Promise<PersistentDedupeEntryMetadata[] | undefined>;
   103	          };
   104	          if (typeof metadataStore.entries === "function") {
   105	            const entries = await metadataStore.entries();
   106	            if (Array.isArray(entries)) {
   107	              const entry = entries.find((candidate) => candidate.key === key);
   108	              if (!entry) {
   109	                return false;
   110	              }
   111	              if (entry.expiresAt !== undefined) {
   112	                // Legacy TTL-bound entries must never become permanent memory hits.
   113	                return entry.expiresAt > Date.now();
   114	              }
   115	            }
   116	          }
   117	        }
   118	      } catch (error) {
   119	        disablePersistentStore(error);
   120	        return false;
   121	      }
   122	      const recordedAt = params.persistent.readTimestamp?.(record);
   123	      if (recordedAt !== undefined && params.ttlMs > 0 && Date.now() - recordedAt >= params.ttlMs) {
   124	        return false;
   125	      }
   126	      memory.check(key, recordedAt);
   127	      return true;
   128	    },
   129	    register: async (key, record, opts) => {
   130	      memory.check(key, opts?.at);
   131	      const store = getPersistentStore();
   132	      if (!store) {
   133	        return;
   134	      }
   135	      try {
   136	        await store.register(key, record);
   137	      } catch (error) {
   138	        disablePersistentStore(error);
   139	      }
   140	    },
   141	    clearForTest: () => {
   142	      memory.clear();
   143	      persistentStore = undefined;
   144	      persistentStoreDisabled = false;
   145	    },
   146	  };
   147	}

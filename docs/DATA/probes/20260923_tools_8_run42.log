   120	      {
   121	        "id": "github",
   122	        "source": "oc://openclaw.config/auth/profiles/github",
   123	        "validMetadata": true,
   124	        "provider": "github",
   125	        "mode": "token"
   126	      }
   127	    ],
   128	    "tools": [
   129	      {
   130	        "id": "deploy",

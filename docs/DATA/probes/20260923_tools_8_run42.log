import re, pathlib
root = pathlib.Path('/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-026/openclaw/docs')
out = []
for p in sorted(root.rglob('*')):
    if not p.is_file():
        continue
    if p.suffix.lower() not in ('.md', '.mdx', '.rst', '.ipynb'):
        continue
    try:
        text = p.read_text(errors='replace')
    except Exception:
        text = ''
    title = ''
    m = re.search(r'^---\s*\n(.*?)\n---\s*\n', text, re.S)
    fm = m.group(1) if m else ''
    tm = re.search(r'^title:\s*"?(.*?)"?\s*$', fm, re.M)
    if tm:
        title = tm.group(1)
    else:
        hm = re.search(r'^#\s+(.*)$', text[m.end() if m else 0:], re.M)
        if hm:
            title = hm.group(1)
    out.append(str(p) + '\t' + title)
pathlib.Path('/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-026/sb42/docs_titles.tsv').write_text('\n'.join(out) + '\n')
print('total_pages=%d' % len(out))

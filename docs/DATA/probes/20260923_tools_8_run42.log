import csv
rows = []
with open('/home/user/trade/docs/DATA/tools_catalog_cat8.tsv', encoding='utf-8') as f:
    r = csv.reader(f, delimiter='\t')
    header = next(r)
    for row in r:
        if not row or not row[0].strip():
            continue
        rows.append(row)
idx = {name: i for i, name in enumerate(header)}
elems = ['E1a','E1b','E2','E3a','E3b','E4','E5','E6']
cand_lines = []
elem_lines = []
n = 0
for row in rows:
    n += 1
    num = row[idx['番号']]
    name = row[idx['名前']]
    status = row[idx['状態']]
    if num == '8-026':
        cand_lines.append(str(n) + '. `' + name + '` (' + num + ') -- E2_E4_E6_THIS_ROUND_PLACEHOLDER -- status: ' + status)
    else:
        prefix = '[fukabori] ' if status == '深掘り' else ''
        cand_lines.append(str(n) + '. ' + prefix + '`' + name + '` (' + num + ') -- ledger-as-is -- status: ' + status)
    for e in elems:
        val = row[idx[e]]
        dan = row[idx['段_'+e]]
        if num == '8-026' and e in ('E2','E4','E6'):
            elem_lines.append('| `' + name + '` | ' + e + ' | UNDETERMINED_PLACEHOLDER | UNDETERMINED_PLACEHOLDER | actual-measurement | PLACEHOLDER | PLACEHOLDER |')
        else:
            elem_lines.append('| `' + name + '` | ' + e + ' | ' + val + ' | ' + dan + ' | primary-source | ledger-as-is-round41 |  |')
with open('/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-026/sb42/run42_candlist.txt', 'w', encoding='utf-8') as f:
    f.write(chr(10).join(cand_lines) + chr(10))
with open('/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-026/sb42/run42_elemtable.txt', 'w', encoding='utf-8') as f:
    f.write(chr(10).join(elem_lines) + chr(10))
print('wrote', len(cand_lines), 'candidate lines and', len(elem_lines), 'element rows')

/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-032/src/kafka/docs/streams/developer-guide/config-streams.md:1350:>         final Foo myPojo = (Foo) record.value();

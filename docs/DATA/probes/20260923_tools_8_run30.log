/tmp/claude-0/-home-user-trade/2da9385f-4fe4-506a-be3d-78153c549662/scratchpad/cat8/venvs/8-032/src/kafka/docs/kafka-connect/connector-development-guide.md:416:Schema schema = SchemaBuilder.struct().name(NAME)

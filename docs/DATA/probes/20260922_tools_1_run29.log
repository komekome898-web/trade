$ python3 - <<EOF
import re
L=open("docs/DATA/SCAN_2026-09-21_tools.md").read().split("\n")
row=[l for l in L if l.startswith("| **型 2 — 呼ぶが、既定では無効**")][0]
cell=row.split("|")[4]
t2=[int(x) for x in re.findall(r"(?:^|・)\s*(\d+) \`", cell)]
i=[k for k,l in enumerate(L) if l.startswith("**段(機構)と段(既定)が同じでない候補は")][0]
j=[k for k,l in enumerate(L[i:], i) if l.startswith("| 候補 | 機構 | 既定 | 下がる理由 |")][0]
st=[]
for l in L[j+2:]:
    if not l.startswith("| "): break
    st.append(int(re.match(r"\| (\d+) \`", l).group(1)))
print("型2 =", len(t2), sorted(t2))
print("段が違う =", len(st), sorted(st))
print("共通 =", len(set(t2)&set(st)), sorted(set(t2)&set(st)))
print("型2 のみ =", len(set(t2)-set(st)), sorted(set(t2)-set(st)))
print("段のみ =", len(set(st)-set(t2)), sorted(set(st)-set(t2)))
EOF

    run_dir: Path,
    *,
    tolerance: float = 1e-9,
) -> RunCoherenceSummary:
    results_path = run_dir / "results.json"
    if not results_path.exists():
        raise FileNotFoundError(f"Missing results.json in {run_dir}")

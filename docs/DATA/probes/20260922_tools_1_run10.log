### $SP/r10/pst_limit_min.py
# pysystemtrade の systems/accounts/order_simulator/hourly_limit_orders.py を
# 合成データだけで動かす。当方のデータ・鍵・記録は一切使わない。
import sys, time, datetime
sys.path.insert(0, sys.argv[1])
import numpy as np, pandas as pd

from systems.accounts.order_simulator.pandl_order_simulator import (
    OrdersSeriesData,
    generate_positions_orders_and_fills_from_series_data,
    get_order_sim_daily_data_at_idx_point,
    generate_order_and_fill_at_idx_point_for_market_orders,
)
from systems.accounts.order_simulator.hourly_limit_orders import (
    generate_order_and_fill_at_idx_point_for_limit_orders,
    HourlyOrderSimulatorOfLimitOrders,
)
t0 = time.time()
print("MODULE_FILE=%s" % sys.modules["systems.accounts.order_simulator.hourly_limit_orders"].__file__)
print("LIMIT_SIM_CLASS_MRO=%s" % [c.__name__ for c in HourlyOrderSimulatorOfLimitOrders.__mro__][:4])

# --- 合成の時間足: 1 時間刻み 400 本、乱数の種を固定 ---
n = 400
idx = pd.date_range("2026-01-01 00:00:00", periods=n, freq="h")
rng = np.random.default_rng(20260922)
price = pd.Series(100.0 * np.exp(np.cumsum(rng.normal(0, 0.002, n))), index=idx)
# 最適建玉: 前半 +2 枚、後半 -2 枚(= 指値と成行で 1 往復以上が必ず出る)
opt = pd.Series(np.concatenate([np.full(n // 2, 2.0), np.full(n - n // 2, -2.0)]), index=idx)
sd = OrdersSeriesData(price_series=price, unrounded_positions=opt)
print("SYNTH_BARS=%d PRICE_FIRST=%.6f PRICE_LAST=%.6f" % (n, price.iloc[0], price.iloc[-1]))

def pnl(fills, last_price):
    cash = 0.0; pos = 0
    for f in fills:
        cash -= f.qty * f.price; pos += f.qty
    return cash + pos * last_price, pos

for name, fn in (("MARKET", generate_order_and_fill_at_idx_point_for_market_orders),
                 ("LIMIT", generate_order_and_fill_at_idx_point_for_limit_orders)):
    r = generate_positions_orders_and_fills_from_series_data(
        series_data=sd,
        passed_idx_data_function=get_order_sim_daily_data_at_idx_point,
        passed_orders_fills_function=fn)
    orders = r.list_of_orders; fills = r.list_of_fills
    p, pos = pnl(fills, float(price.iloc[-1]))
    print("%s_ORDER_COUNT=%d %s_FILL_COUNT=%d %s_UNFILLED=%d" % (
        name, len(orders), name, len(fills), name, len(orders) - len(fills)))
    print("%s_FINAL_POSITION=%d %s_PNL=%.6f" % (name, pos, name, p))
    df = orders.as_pd_df()
    print("%s_ORDER_COLS=%s" % (name, list(df.columns)))
    print("%s_ORDER_HEAD2=%s" % (name, df.head(2).to_string().replace("\n", " / ")))
    fdf = fills.as_pd_df()
    print("%s_FILL_HEAD2=%s" % (name, fdf.head(2).to_string().replace("\n", " / ")))
    if name == "LIMIT":
        print("LIMIT_PRICE_NONNULL=%d LIMIT_PRICE_NULL=%d" % (
            int(df["limit_price"].notna().sum()), int(df["limit_price"].isna().sum())))
        buy = df[df["quantity"] > 0]; sell = df[df["quantity"] < 0]
        print("LIMIT_BUY_ORDERS=%d LIMIT_SELL_ORDERS=%d" % (len(buy), len(sell)))

# --- 約定判定の規則そのものを 4 通りで直接確かめる ---
from systems.accounts.order_simulator.fills_and_orders import fill_from_simple_limit_order
from systems.accounts.order_simulator.simple_orders import SimpleOrderWithDate
d = datetime.datetime(2026, 1, 1)
for q, lp, mp in ((1, 101.0, 100.0), (1, 99.0, 100.0), (-1, 99.0, 100.0), (-1, 101.0, 100.0)):
    f = fill_from_simple_limit_order(SimpleOrderWithDate(quantity=q, limit_price=lp, submit_date=d),
                                     market_price=mp, fill_datetime=d)
    print("RULE q=%+d limit=%.1f next_mkt=%.1f -> is_unfilled=%s qty=%s price=%s slippage_adj=%s" % (
        q, lp, mp, f.is_unfilled, f.qty, f.price, f.price_requires_slippage_adjustment))
print("ELAPSED_S=%.2f" % (time.time() - t0))
### $SP/r10/pst_scale.py
import sys, time
sys.path.insert(0, sys.argv[1])
import numpy as np, pandas as pd
from systems.accounts.order_simulator.pandl_order_simulator import (
    OrdersSeriesData, generate_positions_orders_and_fills_from_series_data,
    get_order_sim_daily_data_at_idx_point)
from systems.accounts.order_simulator.hourly_limit_orders import (
    generate_order_and_fill_at_idx_point_for_limit_orders)
import warnings; warnings.simplefilter("ignore")
for n in (10000, 100000):
    idx = pd.date_range("2026-01-01", periods=n, freq="min")
    rng = np.random.default_rng(20260922)
    price = pd.Series(100.0*np.exp(np.cumsum(rng.normal(0,0.0005,n))), index=idx)
    opt = pd.Series(np.round(np.sin(np.arange(n)/500.0)*3.0), index=idx)
    sd = OrdersSeriesData(price_series=price, unrounded_positions=opt)
    t0=time.time()
    r = generate_positions_orders_and_fills_from_series_data(
        series_data=sd, passed_idx_data_function=get_order_sim_daily_data_at_idx_point,
        passed_orders_fills_function=generate_order_and_fill_at_idx_point_for_limit_orders)
    el=time.time()-t0
    print("SCALE_BARS=%d ELAPSED_S=%.3f BARS_PER_S=%.1f ORDERS=%d FILLS=%d" % (
        n, el, n/el, len(r.list_of_orders), len(r.list_of_fills)))
# 決定性: 同じ入力を 2 回走らせて結果が一致するか
idx = pd.date_range("2026-01-01", periods=2000, freq="min")
rng = np.random.default_rng(20260922)
price = pd.Series(100.0*np.exp(np.cumsum(rng.normal(0,0.0005,2000))), index=idx)
opt = pd.Series(np.round(np.sin(np.arange(2000)/300.0)*3.0), index=idx)
sd = OrdersSeriesData(price_series=price, unrounded_positions=opt)
outs=[]
for _ in range(2):
    r = generate_positions_orders_and_fills_from_series_data(
        series_data=sd, passed_idx_data_function=get_order_sim_daily_data_at_idx_point,
        passed_orders_fills_function=generate_order_and_fill_at_idx_point_for_limit_orders)
    outs.append(r.list_of_fills.as_pd_df().to_csv())
print("DETERMINISTIC_TWO_RUNS_IDENTICAL=%s" % (outs[0]==outs[1]))

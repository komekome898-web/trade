def simulate(ser, trades, side: str, ignore_queue: bool = False):
    """Nos fills sur un côté. Retourne [(ts, prix, attente_s, queue_initiale)].

    Règle : on rejoint le meilleur bid. Si le meilleur bid bouge, notre ordre
    n'y est plus — on annule et on repose, ce qui remet la file à zéro. C'est
    le coût caché de la cotation au toucher : chaque mouvement du bid nous
    renvoie en fin de file.
    """
    serie = ser.get(side) or []
    if not serie:
        return []
    fills = []
    price = None          # notre prix posté
    queue = 0.0           # ce qui reste devant nous
    queue0 = 0.0          # ce qu'il y avait devant nous EN POSTANT
    since = 0             # depuis quand on est posté

